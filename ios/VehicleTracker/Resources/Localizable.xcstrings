          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konkolaataan %@ siif hin ramadamne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie masz przypisanego pojazdu %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O veículo %@ não está atribuído a você."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leʻi tofia ʻoe i le taʻavale %@."
