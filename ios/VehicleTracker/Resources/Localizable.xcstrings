        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Naka-off ang Precise Location. I-on ito sa Settings para lumabas ang sasakyan sa tamang kalsada."
          }
        },
        "fr" : {
          "stringUnit" : {
