    "Keep driving. Reports start again with the signal." : {
      "comment" : "Help, under 'No connection'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "መንዳትዎን ይቀጥሉ። ኔትወርክ ሲመለስ ሪፖርት መላክ እንደገና ይጀምራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تابع القيادة. يبدأ إرسال التقارير من جديد مع عودة الإشارة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fahren Sie weiter. Sobald der Empfang zurück ist, wird wieder gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sigue manejando. Los reportes se reanudan cuando vuelva la señal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "به رانندگی ادامه دهید. با برگشتن آنتن، ارسال گزارش‌ها دوباره شروع می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jatka ajoa. Raportointi jatkuu, kun kenttä palaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tuloy lang sa pagmamaneho. Magsisimula ulit ang mga report pagbalik ng signal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continuez à rouler. L’envoi reprend dès que le réseau revient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "गाड़ी चलाते रहें। सिग्नल लौटते ही रिपोर्ट फिर से शुरू हो जाती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontinye kondi. Rapò yo rekòmanse lè rezo a tounen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continua a guidare. Le segnalazioni ripartono quando torna il segnale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "そのまま運転を続けてください。電波が戻ると送信が再開されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "បន្តបើកបរ។ ការផ្ញើទីតាំងនឹងចាប់ផ្ដើមឡើងវិញ ពេលមានសញ្ញាវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "계속 운전하세요. 신호가 돌아오면 위치 전송이 다시 시작돼요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ຂັບຕໍ່ໄປ. ການລາຍງານຈະເລີ່ມຄືນເມື່ອມີສັນຍານ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konkolaachisuu itti fufi. Gabaasni yommuu neetworkiin deebi'u irra deebi'ee jalqaba."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਗੱਡੀ ਚਲਾਉਂਦੇ ਰਹੋ। ਸਿਗਨਲ ਆਉਂਦੇ ਹੀ ਰਿਪੋਰਟਾਂ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਹੋ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedź dalej. Raporty ruszą ponownie, gdy wróci zasięg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continue dirigindo. O envio recomeça quando o sinal voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Продолжайте ехать. Когда появится сигнал, отправка возобновится."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ʻAve pea le taʻavale. E toe amata lipoti pe a toe maua le fesoʻotaʻiga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gaariga sii wad. Warbixintu way dib u bilaabmaysaa marka shabakaddu soo laabato."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Endelea kuendesha. Ripoti zitaanza tena mtandao ukirudi."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ምዝዋር ቀጽሉ። ሲግናል ምስ ተመልሰ ጸብጻባት ደጊሞም ይጅምሩ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Їдьте далі. Звіти знову надсилатимуться, коли з’явиться сигнал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
