    },
    "You're not assigned to vehicle %@." : {
      "comment" : "Banner when the server refused a start because the driver is not assigned to the vehicle: the fleet number, e.g. 'You're not assigned to vehicle 4317.'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fahrzeug %@ ist Ihnen nicht zugewiesen."
