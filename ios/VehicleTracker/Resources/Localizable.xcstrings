    "Search by the number on the sign, or part of the name." : {
      "comment" : "Empty state text under 'No route matches …'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suchen Sie nach der Nummer auf dem Schild oder einem Teil des Namens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Busca por el número del letrero o por parte del nombre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hae linjakilven numerolla tai osalla nimeä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maghanap gamit ang numero sa karatula, o bahagi ng pangalan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cherchez avec le numéro sur le panneau, ou une partie du nom."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बोर्ड पर लिखे नंबर से, या नाम के किसी हिस्से से खोजें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chèche ak nimewo ki sou pano a, oswa yon moso nan non an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cerca per numero sul cartello o per parte del nome."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lakkoofsa gabatee irra jiruun yookaan kutaa maqaa isaatiin barbaadi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wpisz numer z tablicy albo część nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Busque pelo número do letreiro ou por parte do nome."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suʻe i le numera i luga o le faʻailoga, poʻo se vaega o le igoa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ku raadi lambarka calaamadda ku qoran, ama qayb ka mid ah magaca."
