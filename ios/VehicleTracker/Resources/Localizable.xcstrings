            "state" : "machine_translated",
            "value" : "Có sự cố ở máy chủ. Hãy báo điều độ."
          }
        }
      }
    },
    "A trip is already starting or running." : {
      "comment" : "Error when a start is attempted while a trip is already starting or running.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
