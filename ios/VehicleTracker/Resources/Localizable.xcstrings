    "Only continue if your agency sent you this link." : {
      "comment" : "Setup link alert: under 'Use tracker.example.org?'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ይህን ሊንክ የላከልዎ ድርጅትዎ ከሆነ ብቻ ይቀጥሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تابع فقط إذا أرسلت لك جهة عملك هذا الرابط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Machen Sie nur weiter, wenn Ihr Verkehrsbetrieb Ihnen diesen Link geschickt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continúa solo si tu empresa te envió este enlace."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فقط اگر شرکت شما این لینک را برایتان فرستاده، ادامه دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jatka vain, jos liikennöitsijäsi lähetti sinulle tämän linkin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ituloy lang kung ang kumpanya mo ang nagpadala sa iyo ng link na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continuez seulement si votre compagnie vous a envoyé ce lien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आगे तभी बढ़ें जब यह लिंक आपकी एजेंसी ने भेजा हो।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontinye sèlman si se konpayi ou ki voye lyen sa a ba ou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continua solo se questo link te l'ha inviato la tua azienda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このリンクが事業者から送られてきた場合のみ、続行してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "បន្តតែក្នុងករណីក្រុមហ៊ុនរបស់អ្នកបានផ្ញើតំណនេះមកអ្នកប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "회사에서 보낸 링크일 때만 계속하세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ສືບຕໍ່ສະເພາະເມື່ອບໍລິສັດຂອງທ່ານສົ່ງລິ້ງນີ້ໃຫ້ທ່ານ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yoo dhaabbatni kee liinkii kana siif erge qofa itti fufi."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਅੱਗੇ ਤਾਂ ਹੀ ਵਧੋ ਜੇ ਇਹ ਲਿੰਕ ਤੁਹਾਡੀ ਏਜੰਸੀ ਨੇ ਭੇਜਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontynuuj tylko wtedy, gdy ten link wysłał ci przewoźnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Só continue se este link foi enviado pela sua empresa."
          }
        },
        "ru" : {
          "stringUnit" : {
