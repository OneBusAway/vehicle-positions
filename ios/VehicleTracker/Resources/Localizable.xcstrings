    "The app needs these to report vehicle %@. iOS asks about each one next." : {
      "comment" : "Under the checklist's title: the vehicle's fleet number, e.g. 'The app needs these to report vehicle 4317. iOS asks about each one next.'",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "የመኪና %@ ሪፖርት ለመላክ መተግበሪያው እነዚህን ይፈልጋል። ቀጥሎ iOS ስለ እያንዳንዳቸው ይጠይቃል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتاج التطبيق إلى ما يلي لإرسال تقارير المركبة %@. سيسألك iOS عن كل منها بعد ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die App braucht Folgendes, um die Position von Fahrzeug %@ zu senden. iOS fragt gleich nach jedem Punkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La app necesita lo siguiente para enviar la ubicación del vehículo %@. iOS te preguntará por cada punto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "برنامه برای گزارش‌دهی خودروی %@ به این‌ها نیاز دارد. iOS در ادامه درباره هر کدام می‌پرسد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sovellus tarvitsee nämä ajoneuvon %@ raportointiin. iOS kysyy niistä seuraavaksi yksi kerrallaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kailangan ng app ang mga ito para i-report ang sasakyan %@. Isa-isang itatanong ng iOS ang mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour envoyer la position du véhicule %@, l’application a besoin de ce qui suit. iOS vous posera la question pour chacun."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "गाड़ी %@ की रिपोर्ट भेजने के लिए ऐप को ये चाहिए। iOS आगे हर एक के बारे में पूछेगा।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikasyon an bezwen bagay sa yo pou l voye rapò pou machin %@. iOS ap mande ou pou chak youn apre sa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L'app ha bisogno di questi permessi per inviare le segnalazioni del veicolo %@. iOS te li chiederà uno alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "車両 %@ の位置を送信するには、次の設定が必要です。このあと iOS が1つずつ確認します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "កម្មវិធីត្រូវការទាំងនេះ ដើម្បីផ្ញើទីតាំងយានយន្ត %@។ បន្ទាប់មក iOS នឹងសួរម្ដងមួយៗ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "차량 %@의 위치를 전송하려면 앱에 다음 항목이 필요해요. 이어서 iOS가 하나씩 물어봐요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ແອັບຕ້ອງການສິ່ງເຫຼົ່ານີ້ເພື່ອລາຍງານລົດ %@. ຕໍ່ໄປ iOS ຈະຖາມທີລະຢ່າງ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konkolaataa %@ gabaasuuf appiin wantoota kana barbaada. Itti aansee iOS tokkoon tokkoon isaanii si gaafata."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਗੱਡੀ %@ ਦੀਆਂ ਰਿਪੋਰਟਾਂ ਭੇਜਣ ਲਈ ਐਪ ਨੂੰ ਇਹ ਚਾਹੀਦੇ ਹਨ। iOS ਅੱਗੇ ਹਰੇਕ ਬਾਰੇ ਪੁੱਛੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikacja potrzebuje tych rzeczy, aby wysyłać raporty z pojazdu %@. iOS zaraz zapyta o każdą z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O app precisa destes itens para enviar as posições do veículo %@. O iOS vai perguntar sobre cada um a seguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это нужно приложению, чтобы отправлять отметки машины %@. Далее iOS спросит о каждом пункте."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E manaʻomia e le app nei mea e lafo ai lipoti o le taʻavale %@. O le ʻā fesili mai iOS e uiga i mea taʻitasi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App-ku wuxuu u baahan yahay kuwan si uu warbixinta gaariga %@ u diro. iOS ayaa mid walba kaa weydiin doona."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Programu inahitaji haya ili kuripoti gari %@. Kisha iOS itakuuliza kuhusu kila moja."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ጸብጻብ መኪና %@ ንምስዳድ ኣፕ እዚኣቶም የድልይዎ። ቀጺሉ iOS ብዛዕባ ነፍሲ ወከፎም ክሓትት እዩ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Щоб надсилати звіти про транспортний засіб %@, застосунку потрібно ось що. Далі iOS запитає про кожен пункт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ứng dụng cần các mục sau để gửi vị trí của xe %@. iOS sẽ hỏi lần lượt từng mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "应用需要以下各项才能上报车辆 %@ 的位置。iOS 接下来会逐项询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "應用程式需要這些權限，才能回報車輛 %@ 的位置。接下來 iOS 會逐一詢問。"
          }
        }
      }
    },
    "The iPhone is finding its position." : {
