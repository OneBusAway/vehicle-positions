    "Can't reach %@. Check your connection, or the server address." : {
      "comment" : "Banner above the sign-in button when nothing answered. The server's address as the driver knows it, e.g. 'tracker.example.org'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ist nicht erreichbar. Prüfen Sie Ihre Verbindung oder die Serveradresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede conectar con %@. Revisa tu conexión o la dirección del servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ei yhteyttä palvelimeen %@. Tarkista yhteytesi tai palvelimen osoite."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi maabot ang %@. I-check ang koneksyon mo, o ang address ng server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible de joindre %@. Vérifiez votre connexion ou l’adresse du serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ तक नहीं पहुँच पा रहे। अपना कनेक्शन या सर्वर का पता जाँचें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nou pa ka jwenn %@. Tcheke entènèt ou, oswa adrès sèvè a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile raggiungere %@. Controlla la connessione o l'indirizzo del server."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ qunnamuu hin danda'amu. Interneetii kee yookaan teessoo sarvarii ilaali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brak łączności z %@. Sprawdź połączenie lub adres serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível acessar %@. Verifique sua conexão ou o endereço do servidor."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E lē mafai ona oʻo atu i %@. Siaki lau fesoʻotaʻiga, poʻo le tuatusi o le server."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ lama heli karo. Hubi internetkaaga, ama cinwaanka server-ka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imeshindwa kufikia %@. Angalia mtandao wako, au anwani ya seva."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không kết nối được với %@. Hãy kiểm tra kết nối mạng hoặc địa chỉ máy chủ."
          }
        }
      }
    },
