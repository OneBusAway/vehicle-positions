    "Ahead of the timetable. Riders may miss you." : {
      "comment" : "Help, under a status like '3 min early'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ከጊዜ ሰሌዳው ቀድመዋል። ተሳፋሪዎች ላይደርሱብዎት ይችላሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مبكر عن الجدول. قد لا يلحق بك الركاب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Früher als laut Fahrplan. Fahrgäste könnten Sie verpassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con adelanto respecto al horario. Los pasajeros podrían no alcanzarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جلوتر از برنامه زمانی. ممکن است مسافران جا بمانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aikataulua edellä. Matkustajat voivat jäädä kyydistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maaga sa schedule. Baka maiwan mo ang mga pasahero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En avance sur l’horaire. Des passagers risquent de rater votre véhicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टाइम टेबल से आगे। यात्रियों की गाड़ी छूट सकती है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An avans sou orè a. Pasaje yo ka rate w."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In anticipo sull'orario. I passeggeri potrebbero perderti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "時刻表より早く運行しています。乗客が乗り遅れるおそれがあります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "លឿនជាងកាលវិភាគ។ អ្នកដំណើរអាចមកមិនទាន់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "시간표보다 빨라요. 승객이 차량을 놓칠 수 있어요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ໄວກວ່າຕາຕະລາງເວລາ. ຜູ້ໂດຍສານອາດຈະຂຶ້ນລົດບໍ່ທັນ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagantaa yeroo irraa dursite. Imaltoonni si dhabuu danda'u."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਟਾਈਮ ਟੇਬਲ ਤੋਂ ਅੱਗੇ। ਸਵਾਰੀਆਂ ਪਿੱਛੇ ਰਹਿ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedziesz przed czasem. Pasażerowie mogą nie zdążyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiantado em relação ao horário. Os passageiros podem perder o veículo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вы опережаете расписание. Пассажиры могут опоздать на вашу машину."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E vave i lō le faʻasologa o taimi. Atonu e lē maua ʻoe e pasese."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waad ka horreysaa jadwalka. Rakaabku way ku seegi karaan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mbele ya ratiba. Abiria wanaweza kukukosa."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ካብ መደብ ግዜ ቀዲምኩም። ተጓዓዝቲ ከይተሰቐሉ ክተርፉ ይኽእሉ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Випереджаєте розклад. Пасажири можуть на вас не встигнути."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sớm hơn lịch trình. Hành khách có thể bị lỡ xe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "早于时刻表。乘客可能会错过你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "比時刻表早。乘客可能會錯過你。"
          }
        }
      }
    },
