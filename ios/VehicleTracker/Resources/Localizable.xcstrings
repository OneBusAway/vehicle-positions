        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec CarPlay. L’envoi démarre quand vous ouvrez l’application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CarPlay से शुरू हुई ट्रिप में, ऐप खोलते ही रिपोर्ट शुरू हो जाती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ak CarPlay. Rapò yo kòmanse lè ou louvri aplikasyon an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con CarPlay. Le segnalazioni partono quando apri l'app."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CarPlay waliin. Yommuu appii bantu gabaasni jalqaba."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Z CarPlay. Raporty ruszą, gdy otworzysz aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
