        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस लिंक में ऐसा सर्वर पता नहीं है जिसे ऐप इस्तेमाल कर सके।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lyen sa a pa gen okenn adrès sèvè aplikasyon an ka sèvi avè l."
