    "Reports have stopped. Sign in to go on. Your trip is still open." : {
      "comment" : "Help, under 'Signed out'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es werden keine Meldungen mehr gesendet. Melden Sie sich an, um weiterzumachen. Ihre Fahrt ist noch offen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los reportes se detuvieron. Inicia sesión para continuar. Tu viaje sigue abierto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Raportointi on pysähtynyt. Kirjaudu sisään jatkaaksesi. Matkasi on vielä kesken."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Huminto na ang mga report. Mag-sign in para magpatuloy. Bukas pa ang trip mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’envoi s’est arrêté. Connectez-vous pour continuer. Votre trajet est toujours en cours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिपोर्ट रुक गई हैं। आगे बढ़ने के लिए साइन इन करें। आपकी ट्रिप अभी खुली है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rapò yo kanpe. Konekte pou kontinye. Vwayaj ou a toujou louvri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le segnalazioni si sono interrotte. Accedi per continuare. Il tuo viaggio è ancora aperto."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gabaasni dhaabbateera. Itti fufuuf seeni. Imalli kee ammallee banaadha."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Raporty się zatrzymały. Zaloguj się, aby kontynuować. Twój przejazd jest nadal otwarty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O envio de posições parou. Entre para continuar. Sua viagem ainda está aberta."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ʻUa taofi lipoti. Saini i totonu e faʻaauau ai. O loʻo tatala pea lau malaga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Warbixinnadu way joogsadeen. Soo gal si aad u sii wadato. Safarkaagu weli wuu furan yahay."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ripoti zimesimama. Ingia ili uendelee. Safari yako bado haijaisha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã ngừng gửi vị trí. Đăng nhập để tiếp tục. Hành trình của bạn vẫn đang mở."
          }
        }
      }
    },
