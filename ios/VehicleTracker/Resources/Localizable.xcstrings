    "Riders see your last position until it comes back." : {
      "comment" : "Help, under 'No GPS signal'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "እስኪመለስ ድረስ ተሳፋሪዎች የመጨረሻ ቦታዎን ያያሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يرى الركاب آخر موقع لك حتى تعود الإشارة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bis das Signal zurück ist, sehen Fahrgäste Ihre letzte Position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los pasajeros ven tu última ubicación hasta que vuelva la señal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تا برگشتن آن، مسافران آخرین موقعیت شما را می‌بینند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Matkustajat näkevät viimeisimmän sijaintisi, kunnes GPS palaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ang huling posisyon mo ang nakikita ng mga pasahero hanggang bumalik ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les passagers voient votre dernière position jusqu’au retour du GPS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसके लौटने तक यात्री आपकी आखिरी लोकेशन देखते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pasaje yo wè dènye pozisyon ou jiskaske GPS la tounen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I passeggeri vedono la tua ultima posizione finché il GPS non torna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "GPS が戻るまで、乗客には最後の位置が表示されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "អ្នកដំណើរឃើញទីតាំងចុងក្រោយរបស់អ្នក រហូតដល់មានសញ្ញា GPS វិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "GPS 신호가 돌아올 때까지 승객에게는 마지막 위치가 보여요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ຜູ້ໂດຍສານຈະເຫັນຕຳແໜ່ງສຸດທ້າຍຂອງທ່ານ ຈົນກວ່າ GPS ຈະກັບມາ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hamma GPS deebi'utti imaltoonni bakka kee isa dhumaa argu."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਸਿਗਨਲ ਵਾਪਸ ਆਉਣ ਤੱਕ ਸਵਾਰੀਆਂ ਤੁਹਾਡਾ ਆਖਰੀ ਟਿਕਾਣਾ ਦੇਖਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pasażerowie widzą twoją ostatnią pozycję, dopóki sygnał nie wróci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os passageiros veem sua última posição até o sinal voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пока сигнал не вернётся, пассажиры видят ваше последнее местоположение."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E iloa atu e pasese lou nofoaga mulimuli seʻia toe maua."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rakaabku waxay arkaan goobtaadii ugu dambeysay ilaa uu soo laabto."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abiria wanaona mahali ulipokuwa mwisho hadi GPS irudi."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ሲግናል ክሳዕ ዝምለስ ተጓዓዝቲ ናይ መወዳእታ ቦታኹም ይርእዩ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пасажири бачать ваше останнє місцезнаходження, доки сигнал GPS не повернеться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hành khách thấy vị trí cuối cùng của bạn cho đến khi có lại tín hiệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "GPS 恢复前，乘客会看到你最后的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "GPS 恢復前，乘客會看到你最後的位置。"
          }
        }
      }
