    "Precise Location is off. Turn it on in Settings so the vehicle shows on the right street." : {
      "comment" : "Refusal when the app has only approximate location.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Genauer Standort ist ausgeschaltet. Schalten Sie ihn in den Einstellungen ein, damit das Fahrzeug in der richtigen Straße erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ubicación precisa está desactivada. Actívala en Configuración para que el vehículo aparezca en la calle correcta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tarkka sijainti on pois päältä. Ota se käyttöön kohdassa Asetukset, jotta ajoneuvo näkyy oikealla kadulla."
