    "Vehicle %@ is out of service. Pick another vehicle." : {
      "comment" : "Banner when the server refused a start because the vehicle was taken out of service: the fleet number, e.g. 'Vehicle 4317 is out of service. Pick another vehicle.'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fahrzeug %@ ist außer Betrieb. Wählen Sie ein anderes Fahrzeug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El vehículo %@ está fuera de servicio. Elige otro vehículo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoneuvo %@ on poissa liikenteestä. Valitse toinen ajoneuvo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wala sa serbisyo ang sasakyan %@. Pumili ng ibang sasakyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le véhicule %@ est hors service. Choisissez un autre véhicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "गाड़ी %@ सेवा में नहीं है। कोई दूसरी गाड़ी चुनें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Machin %@ pa an sèvis. Chwazi yon lòt machin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il veicolo %@ è fuori servizio. Scegli un altro veicolo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konkolaataan %@ tajaajila ala jira. Konkolaataa biraa filadhu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pojazd %@ jest wyłączony z ruchu. Wybierz inny pojazd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O veículo %@ está fora de serviço. Escolha outro veículo."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E lē o galue le taʻavale %@. Filifili se isi taʻavale."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gaariga %@ wuu ka baxsan yahay adeegga. Dooro gaari kale."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gari %@ haliko kazini. Chagua gari lingine."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Xe %@ đang ngừng hoạt động. Hãy chọn xe khác."
          }
        }
      }
    },
