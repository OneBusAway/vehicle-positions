          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantenha “Precisa” ativada para os passageiros verem você na rua certa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не выключайте «Высокоточно», чтобы пассажиры видели нужную улицу"
          }
        },
        "sm" : {
          "stringUnit" : {
