    "A problem on the server. Tell your dispatcher." : {
      "comment" : "Help, under 'Server error'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "በሰርቨሩ ላይ ችግር አለ። ለተቆጣጣሪዎ ይንገሩ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مشكلة في الخادم. أبلغ غرفة العمليات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Problem auf dem Server. Informieren Sie die Leitstelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un problema en el servidor. Avísale a tu despachador."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مشکلی در سرور پیش آمده است. به مرکز کنترل خبر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ongelma palvelimella. Kerro asiasta ajojärjestelijälle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "May problema sa server. Sabihan ang dispatcher mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un problème côté serveur. Prévenez votre régulateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सर्वर में दिक्कत है। कंट्रोल रूम को बताएँ।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gen yon pwoblèm nan sèvè a. Fè sant kontwòl la konnen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un problema sul server. Avvisa la centrale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "サーバーに問題があります。運行管理者に連絡してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "មានបញ្ហានៅលើម៉ាស៊ីនមេ។ សូមប្រាប់បន្ទប់បញ្ជា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "서버에 문제가 있어요. 관제실에 알리세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ມີບັນຫາຢູ່ເຊີບເວີ. ແຈ້ງສູນຄວບຄຸມ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sarvarii irratti rakkoon uumame. To'ataa kee beeksisi."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਸਰਵਰ 'ਤੇ ਕੋਈ ਦਿੱਕਤ ਹੈ। ਕੰਟਰੋਲ ਰੂਮ ਨੂੰ ਦੱਸੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Problem na serwerze. Powiadom dyspozytora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um problema no servidor. Avise a central."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Проблема на сервере. Сообщите диспетчеру."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O se faʻafitauli i le server. Taʻu i le ofisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dhibaato ayaa ka jirta server-ka. U sheeg kormeerahaaga."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tatizo kwenye seva. Mwambie mratibu wako."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ኣብ ሰርቨር ጸገም ኣሎ። ንተቖጻጻሪኹም ንገሩ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Проблема на сервері. Повідомте диспетчера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Có sự cố ở máy chủ. Hãy báo điều độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "服务器出现问题。请告知调度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "伺服器發生問題。請告知調度員。"
          }
        }
      }
    },
    "A trip is already starting or running." : {
      "comment" : "Error when a start is attempted while a trip is already starting or running.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "አንድ ጉዞ አስቀድሞ በመጀመር ላይ ወይም እየሄደ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "توجد بالفعل رحلة قيد البدء أو جارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Fahrt startet gerade oder läuft bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya hay un viaje iniciándose o en curso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "یک سفر از قبل در حال شروع یا در جریان است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Matka on jo alkamassa tai käynnissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "May trip nang sinisimulan o tumatakbo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un trajet est déjà en cours ou en train de démarrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "एक ट्रिप पहले से शुरू हो रही है या चल रही है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gen yon vwayaj k ap kòmanse oswa k ap fèt deja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un viaggio è già in avvio o in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "運行がすでに開始中か、進行中です。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "មានដំណើរមួយកំពុងចាប់ផ្ដើម ឬកំពុងដំណើរការរួចហើយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이미 시작 중이거나 진행 중인 운행이 있어요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ມີການເດີນທາງທີ່ກຳລັງເລີ່ມ ຫຼື ກຳລັງດຳເນີນຢູ່ແລ້ວ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imalli tokko duraanuu jalqabamaa yookaan deemaa jira."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਇੱਕ ਟ੍ਰਿਪ ਪਹਿਲਾਂ ਹੀ ਸ਼ੁਰੂ ਹੋ ਰਹੀ ਹੈ ਜਾਂ ਚੱਲ ਰਹੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przejazd już się rozpoczyna lub trwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Já há uma viagem sendo iniciada ou em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поездка уже начинается или идёт."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ʻUa i ai se malaga o loʻo amata poʻo faʻagasolo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waxaa horey u jira safar bilaabmaya ama socda."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
