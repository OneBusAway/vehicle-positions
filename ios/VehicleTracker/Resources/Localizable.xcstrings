    "Location is off for OBA Vehicle Tracker. Turn it on in Settings to start a trip." : {
      "comment" : "Refusal when the app has no location access.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ለOBA Vehicle Tracker አካባቢ ጠፍቷል። ጉዞ ለመጀመር በSettings ውስጥ ያብሩት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الموقع الجغرافي متوقف لتطبيق OBA Vehicle Tracker. شغّله في الإعدادات لبدء رحلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Standort ist für OBA Vehicle Tracker ausgeschaltet. Schalten Sie ihn in den Einstellungen ein, um eine Fahrt zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ubicación está desactivada para OBA Vehicle Tracker. Actívala en Configuración para iniciar un viaje."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مکان برای OBA Vehicle Tracker خاموش است. برای شروع سفر، آن را در Settings روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sijainti on pois päältä OBA Vehicle Tracker -sovellukselle. Ota se käyttöön kohdassa Asetukset, jotta voit aloittaa matkan."
          }
        },
        "fil" : {
          "stringUnit" : {
