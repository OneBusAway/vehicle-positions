        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O servidor não confirmou o encerramento da viagem. Tente novamente ou encerre só neste celular."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leʻi faʻamaonia e le server ʻua uma le malaga. Toe taumafai, poʻo faʻaiʻu naʻo i lenei telefoni."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Server-ku ma xaqiijin in safarku dhammaaday. Isku day mar kale, ama ku dhammee taleefankan oo keliya."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seva haikuthibitisha kuwa safari imeisha. Jaribu tena, au imalize kwenye simu hii pekee."
