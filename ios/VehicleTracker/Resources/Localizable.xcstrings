        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ʻIa ki pea le Precise, ina ʻia iloa atu e pasese le auala saʻo"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Precise” shidan u daa, si rakaabku u arkaan waddada saxda ah"
