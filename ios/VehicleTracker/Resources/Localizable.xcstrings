    "Ahead of the timetable. Riders may miss you." : {
      "comment" : "Help, under a status like '3 min early'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Früher als laut Fahrplan. Fahrgäste könnten Sie verpassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con adelanto respecto al horario. Los pasajeros podrían no alcanzarte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aikataulua edellä. Matkustajat voivat jäädä kyydistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maaga sa schedule. Baka maiwan mo ang mga pasahero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En avance sur l’horaire. Des passagers risquent de rater votre véhicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टाइम टेबल से आगे। यात्रियों की गाड़ी छूट सकती है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An avans sou orè a. Pasaje yo ka rate w."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In anticipo sull'orario. I passeggeri potrebbero perderti."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagantaa yeroo irraa dursite. Imaltoonni si dhabuu danda'u."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
