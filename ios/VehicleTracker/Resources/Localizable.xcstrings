          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ứng dụng đã đóng khi hành trình này đang chạy. Việc gửi vị trí đang tạm dừng cho đến khi bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
