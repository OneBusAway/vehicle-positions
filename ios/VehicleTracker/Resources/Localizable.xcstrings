    },
    "Start the %@ run? Route %@ to %@ on vehicle %@." : {
      "comment" : "CarPlay's start confirmation in one line: the run's start time in the agency's zone, the route's number, the headsign, then the vehicle's fleet number, e.g. 'Start the 6:43 AM run? Route 7 to Downtown Seattle on vehicle 4317.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start the %1$@ run? Route %2$@ to %3$@ on vehicle %4$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ वाला फेरा शुरू करें? रूट %2$@, %3$@ की ओर, गाड़ी %4$@ पर।"
          }
        }
      }
    },
    "Start this run?" : {
      "comment" : "CarPlay: the shortest form of the start confirmation's title, 'Start the 6:43 AM run?', for a car screen too narrow for the run's time.",
