    "An operator has to load one before trips can start. Tell your agency's admin." : {
      "comment" : "Empty state text under 'No schedule on this server yet'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erst muss ein Admin einen Fahrplan laden, dann können Fahrten starten. Sagen Sie dem Admin Ihres Verkehrsbetriebs Bescheid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay que cargar uno antes de poder iniciar viajes. Avísale al administrador de tu empresa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ylläpitäjän on ladattava aikataulu, ennen kuin matkoja voi aloittaa. Kerro asiasta liikennöitsijäsi ylläpitäjälle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kailangan munang mag-load ng schedule ang isang operator bago makapagsimula ng trip. Sabihan ang admin ng kumpanya mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un opérateur doit d’abord en charger pour que les trajets puissent démarrer. Prévenez l’administrateur de votre compagnie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रिप शुरू हो सकें, इसके लिए पहले किसी ऑपरेटर को शेड्यूल लोड करना होगा। अपनी एजेंसी के एडमिन को बताएँ।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yon operatè dwe mete youn anvan vwayaj yo ka kòmanse. Fè administratè konpayi ou a konnen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un operatore deve caricarne uno prima che i viaggi possano iniziare. Avvisa l'amministratore della tua azienda."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imaloonni jalqabuu akka danda'aniif, hojjetaan tokko dura sagantaa fe'uu qaba. Bulchaa dhaabbata keetii beeksisi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozkład musi zostać wgrany, zanim będzie można rozpocząć przejazdy. Powiadom administratora przewoźnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um operador precisa carregar a programação antes de as viagens começarem. Avise o administrador da sua empresa."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E tatau ona utaina muamua se faʻasologa o taimi ona mafai lea ona amata ni malaga. Taʻu i le pule o lau kamupani."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qof shaqaalaha ka mid ah waa inuu jadwal soo geliyaa ka hor inta aan safarro la bilaabin. U sheeg maamulaha shirkaddaada."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ratiba lazima ipakiwe kwanza ndipo safari ziweze kuanza. Mwambie msimamizi wa shirika lako."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Phải có người tải lịch trình lên thì mới bắt đầu được hành trình. Hãy báo quản trị viên của đơn vị vận hành."
          }
        }
      }
    },
    "Another driver has a trip running on vehicle %@. Pick another vehicle or ask your dispatcher." : {
      "comment" : "Banner when the server refused a start because another driver has a trip running on the vehicle: the fleet number, e.g. 'Another driver has a trip running on vehicle 4317. Pick another vehicle or ask your dispatcher.'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit Fahrzeug %@ fährt schon jemand anderes. Wählen Sie ein anderes Fahrzeug oder fragen Sie die Leitstelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Otro conductor tiene un viaje en curso en el vehículo %@. Elige otro vehículo o consulta a tu despachador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toisella kuljettajalla on matka käynnissä ajoneuvolla %@. Valitse toinen ajoneuvo tai kysy ajojärjestelijältä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "May tumatakbong trip ang ibang driver sa sasakyan %@. Pumili ng ibang sasakyan o magtanong sa dispatcher mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un autre chauffeur a un trajet en cours sur le véhicule %@. Choisissez un autre véhicule ou demandez à votre régulateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "गाड़ी %@ पर किसी दूसरे ड्राइवर की ट्रिप चल रही है। कोई दूसरी गाड़ी चुनें या कंट्रोल रूम से पूछें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yon lòt chofè gen yon vwayaj k ap fèt ak machin %@. Chwazi yon lòt machin oswa mande sant kontwòl la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un altro autista ha un viaggio in corso sul veicolo %@. Scegli un altro veicolo o chiedi alla centrale."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konkolaataa %@ irratti konkolaachisaan biraa imala irra jira. Konkolaataa biraa filadhu yookaan to'ataa kee gaafadhu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inny kierowca jedzie już pojazdem %@. Wybierz inny pojazd albo zapytaj dyspozytora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Outro motorista tem uma viagem em andamento no veículo %@. Escolha outro veículo ou fale com a central."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O loʻo i ai se malaga a se isi ʻavetaʻavale i le taʻavale %@. Filifili se isi taʻavale poʻo fesili i le ofisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Darawal kale ayaa safar ku haya gaariga %@. Dooro gaari kale ama weydii kormeerahaaga."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dereva mwingine ana safari inayoendelea kwenye gari %@. Chagua gari lingine au uliza mratibu wako."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một tài xế khác đang chạy hành trình trên xe %@. Hãy chọn xe khác hoặc hỏi điều độ."
          }
        }
      }
    },
    "As %@" : {
      "comment" : "Under the trip card when signing in again: the email the trip's driver signed in with, e.g. 'As jordan.lee@example.org'.",
      "localizations" : {
