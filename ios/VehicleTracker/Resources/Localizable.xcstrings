    "With CarPlay. Reports start when you open the app." : {
      "comment" : "Help, under 'Open the app on iPhone': the line shows when a trip started from the car cannot report until the app is opened on the phone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit CarPlay. Das Senden startet, wenn Sie die App öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con CarPlay. Los reportes empiezan cuando abras la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CarPlayn kanssa. Raportointi alkaa, kun avaat sovelluksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gamit ang CarPlay. Magsisimula ang mga report kapag binuksan mo ang app."
