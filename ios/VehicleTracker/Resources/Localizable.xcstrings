    "Use %@. Plain %@ is allowed only for localhost, 127.0.0.1 or a %@ host." : {
      "comment" : "Under the server field when the address is plain http to a host the app won't send a password to. The values are https://, http:// and .local, as they are.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ይጠቀሙ። ተራ %2$@ የሚፈቀደው localhost፣ 127.0.0.1 ወይም %3$@ ለሆነ አድራሻ ብቻ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "استخدم %1$@. لا يُسمح بـ %2$@ العادي إلا مع localhost أو 127.0.0.1 أو مضيف %3$@."
          }
        },
