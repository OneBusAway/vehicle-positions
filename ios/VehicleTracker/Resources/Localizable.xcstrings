          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pidä “Tarkka” päällä, jotta matkustajat näkevät oikean kadun"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Panatilihing naka-on ang Precise, para makita ng mga pasahero ang tamang kalsada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laissez Position exacte activée pour que les passagers voient la bonne rue"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘सटीक’ चालू रखें, ताकि यात्रियों को सही सड़क दिखे"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kite Precise aktive, pou pasaje yo wè bon lari a"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tieni attiva l'opzione Esatta, così i passeggeri ti vedono sulla strada giusta"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Precise” banaa dhiisi, akka imaltoonni karaa sirrii arganiif"
