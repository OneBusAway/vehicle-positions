    "Choose them, then tap %@. End the trip when you finish." : {
      "comment" : "Welcome, screen 2: under the title. The name of the button that starts a trip, filled in from that button, e.g. 'Choose them, then tap Start trip. End the trip when you finish.'",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "እነዚህን ይምረጡ፣ ከዚያ «%@» የሚለውን ይንኩ። ስራዎ ሲያልቅ ጉዞውን ይጨርሱ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اخترها، ثم انقر على %@. أنهِ الرحلة عند الانتهاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählen Sie sie aus und tippen Sie dann auf „%@“. Beenden Sie die Fahrt, wenn Sie fertig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elígelos y luego toca “%@”. Finaliza el viaje cuando termines."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "این‌ها را انتخاب کنید، بعد روی «%@» بزنید. وقتی کارتان تمام شد، سفر را پایان دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Valitse ne ja napauta sitten “%@”. Lopeta matka, kun olet valmis."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Piliin ang mga ito, saka i-tap ang “%@”. Tapusin ang trip kapag tapos ka na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez-les, puis appuyez sur « %@ ». Terminez le trajet quand vous avez fini."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इन्हें चुनें, फिर ‘%@’ दबाएँ। काम पूरा होने पर ट्रिप खत्म करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chwazi yo, epi peze “%@”. Fini vwayaj la lè ou fin travay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglili, poi tocca “%@”. Termina il viaggio quando hai finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "これらを選び、「%@」をタップしてください。走り終えたら運行を終了してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ជ្រើសរើសទាំងបីនេះ រួចចុច «%@»។ ពេលរួចរាល់ សូមបញ្ចប់ដំណើរ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모두 고른 뒤 ‘%@’ 버튼을 누르세요. 다 마치면 운행을 종료하세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ເລືອກທັງສາມຢ່າງ, ແລ້ວແຕະ “%@”. ຈົບການເດີນທາງເມື່ອສຳເລັດ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isaan filadhu, achiis “%@” tuqi. Yommuu xumurtu imala xumuri."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਇਹ ਤਿੰਨੇ ਚੁਣੋ, ਫਿਰ “%@” ਦਬਾਓ। ਕੰਮ ਪੂਰਾ ਹੋਣ 'ਤੇ ਟ੍ਰਿਪ ਖਤਮ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz je, potem kliknij „%@”. Na koniec zakończ przejazd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha os três e depois toque em “%@”. Encerre a viagem quando terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите их, затем нажмите «%@». В конце завершите поездку."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filifili, ona paʻi lea i “%@”. Faʻaiʻu le malaga pe a uma."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kuwan dooro, kadibna taabo “%@”. Markaad shaqada dhammayso, dhammee safarka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vichague, kisha gusa “%@”. Ukimaliza kazi, maliza safari."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ምረጽዎም፣ ድሕሪኡ ኣብ «%@» ጠውቑ። ምስ ወዳእኩም ጉዕዞ ኣብቅዑ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Виберіть їх, потім натисніть «%@». Коли закінчите, завершіть поїздку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn các mục này, rồi chạm vào “%@”. Kết thúc hành trình khi xong việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "选好后，点击“%@”。跑完后结束行程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "選好後，點一下「%@」。完成後請結束行程。"
          }
        }
      }
    },
