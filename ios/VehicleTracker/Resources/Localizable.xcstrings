          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Faʻatasi ma CarPlay. E amata lipoti pe a e tatala le app."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adigoo CarPlay isticmaalaya. Warbixintu way bilaabmaysaa markaad app-ka furto."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ukitumia CarPlay. Ripoti zitaanza utakapofungua programu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi dùng CarPlay. Sẽ bắt đầu gửi vị trí khi bạn mở ứng dụng."
          }
        }
      }
    },
    "Wrong email or password. Try again." : {
      "comment" : "Under the password field when the server turned the email and password down.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E-Mail oder Passwort falsch. Versuchen Sie es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Correo o contraseña incorrectos. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Väärä sähköposti tai salasana. Yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mali ang email o password. Subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E-mail ou mot de passe incorrect. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ईमेल या पासवर्ड गलत है। फिर से कोशिश करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imèl la oswa modpas la pa bon. Eseye ankò."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Email o password errate. Riprova."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imeeliin yookaan jechi icciitii sirrii miti. Irra deebi'ii yaali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Błędny e-mail lub hasło. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E-mail ou senha incorretos. Tente novamente."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E sese le imeli poʻo le ʻupu faʻalilolilo. Toe taumafai."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Iimaylka ama furaha sirta waa khalad. Isku day mar kale."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Barua pepe au nenosiri si sahihi. Jaribu tena."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sai email hoặc mật khẩu. Hãy thử lại."
          }
        }
      }
    },
    "You already have a trip running. End it before starting another." : {
      "comment" : "Banner when the server refused a start because the driver already has a trip running.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sie haben schon eine laufende Fahrt. Beenden Sie sie, bevor Sie eine neue starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ya tienes un viaje en curso. Finalízalo antes de iniciar otro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sinulla on jo matka käynnissä. Lopeta se, ennen kuin aloitat uuden."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "May trip ka nang tumatakbo. Tapusin ito bago magsimula ng bago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous avez déjà un trajet en cours. Terminez-le avant d’en démarrer un autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी एक ट्रिप पहले से चल रही है। दूसरी शुरू करने से पहले उसे खत्म करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ou gen yon vwayaj k ap fèt deja. Fini l anvan ou kòmanse yon lòt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai già un viaggio in corso. Terminalo prima di iniziarne un altro."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imalli kee tokko duraanuu deemaa jira. Kan biraa jalqabuu dura isa xumuri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masz już trwający przejazd. Zakończ go, zanim zaczniesz kolejny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Você já tem uma viagem em andamento. Encerre-a antes de iniciar outra."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O loʻo faʻagasolo pea lau malaga. Faʻaiʻu aʻo leʻi amataina se isi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waxaad horey u leedahay safar socda. Dhammee ka hor intaadan bilaabin mid kale."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tayari una safari inayoendelea. Imalize kabla ya kuanza nyingine."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn đã có một hành trình đang chạy. Hãy kết thúc hành trình đó trước khi bắt đầu hành trình mới."
          }
        }
      }
    },
    "You are on the timetable." : {
      "comment" : "Help, under 'On time'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sie fahren nach Fahrplan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vas según el horario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Olet aikataulussa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nasa schedule ka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vous suivez l’horaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आप टाइम टेबल के हिसाब से चल रहे हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ou respekte orè a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sei in orario."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagantaa yeroo eegaa jirta."
          }
        },
        "pl" : {
          "stringUnit" : {
