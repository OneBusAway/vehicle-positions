    "The app closed while this trip was running. Reports are paused until you choose." : {
      "comment" : "Under the Resume screen's title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die App wurde während dieser Fahrt geschlossen. Die Meldungen sind pausiert, bis Sie sich entscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La app se cerró mientras este viaje estaba en curso. Los reportes están en pausa hasta que elijas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sovellus sulkeutui matkan aikana. Raportointi on tauolla, kunnes valitset."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nagsara ang app habang tumatakbo ang trip na ito. Naka-pause ang mga report hangga't hindi ka pumipili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’application s’est fermée pendant ce trajet. L’envoi reste en pause jusqu’à votre choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रिप चलते समय ऐप बंद हो गया। जब तक आप कुछ नहीं चुनते, रिपोर्ट रुकी रहेंगी।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikasyon an te fèmen pandan vwayaj sa a t ap fèt. Rapò yo an poz jiskaske ou chwazi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L'app si è chiusa durante il viaggio. Le segnalazioni restano in pausa finché non scegli."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imalli kun osoo deemaa jiruu appiin cufame. Hamma ati filattutti gabaasni yeroof dhaabbata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikacja zamknęła się w trakcie przejazdu. Raporty są wstrzymane do twojej decyzji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O app fechou durante esta viagem. O envio de posições está pausado até você escolher."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na tāpuni le app aʻo faʻagasolo lenei malaga. ʻUa taofi muamua lipoti seʻia e filifili."
          }
        },
        "so" : {
