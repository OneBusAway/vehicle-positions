    "Do these 3 things on every trip." : {
      "comment" : "Welcome, screen 3: under the title.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "በእያንዳንዱ ጉዞ እነዚህን 3 ነገሮች ያድርጉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "٣ أمور افعلها في كل رحلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Achten Sie bei jeder Fahrt auf diese 3 Dinge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haz estas 3 cosas en cada viaje."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "در هر سفر این ۳ کار را انجام دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tee nämä 3 asiaa joka matkalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gawin ang 3 bagay na ito sa bawat trip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Faites ces 3 choses à chaque trajet."
          }
        },
        "hi" : {
