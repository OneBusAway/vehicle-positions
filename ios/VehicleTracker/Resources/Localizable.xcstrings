        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continuez à rouler. L’envoi reprend dès que le réseau revient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "गाड़ी चलाते रहें। सिग्नल लौटते ही रिपोर्ट फिर से शुरू हो जाती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kontinye kondi. Rapò yo rekòmanse lè rezo a tounen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continua a guidare. Le segnalazioni ripartono quando torna il segnale."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konkolaachisuu itti fufi. Gabaasni yommuu neetworkiin deebi'u irra deebi'ee jalqaba."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedź dalej. Raporty ruszą ponownie, gdy wróci zasięg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Continue dirigindo. O envio recomeça quando o sinal voltar."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ʻAve pea le taʻavale. E toe amata lipoti pe a toe maua le fesoʻotaʻiga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gaariga sii wad. Warbixintu way dib u bilaabmaysaa marka shabakaddu soo laabato."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Endelea kuendesha. Ripoti zitaanza tena mtandao ukirudi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cứ tiếp tục lái. Khi có sóng trở lại, vị trí sẽ được gửi tiếp."
          }
        }
      }
    },
