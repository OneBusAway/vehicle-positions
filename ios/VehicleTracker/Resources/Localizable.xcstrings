    "Far from the timetable. Check you chose the right run." : {
      "comment" : "Help, under 'Off schedule'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ከጊዜ ሰሌዳው በጣም ርቀዋል። ትክክለኛውን ዙር መምረጥዎን ያረጋግጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بعيد جدًا عن الجدول. تأكد من أنك اخترت الدورة الصحيحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Weit weg vom Fahrplan. Prüfen Sie, ob Sie den richtigen Kurs gewählt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muy lejos del horario. Revisa que hayas elegido la salida correcta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "خیلی دور از برنامه زمانی. بررسی کنید سرویس درست را انتخاب کرده باشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kaukana aikataulusta. Tarkista, että valitsit oikean vuoron."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Malayo sa schedule. I-check kung tama ang biyaheng pinili mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Loin de l’horaire. Vérifiez que vous avez choisi la bonne course."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टाइम टेबल से बहुत दूर। जाँच लें कि आपने सही फेरा चुना है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Byen lwen orè a. Tcheke si ou chwazi bon kous la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Molto fuori orario. Controlla di aver scelto la corsa giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "時刻表から大きく外れています。正しい便を選んだか確認してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ខុសឆ្ងាយពីកាលវិភាគ។ សូមពិនិត្យថាអ្នកបានជ្រើសរើសជើងត្រឹមត្រូវ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "시간표와 많이 달라요. 배차를 맞게 골랐는지 확인하세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ຫ່າງຈາກຕາຕະລາງເວລາຫຼາຍ. ກວດເບິ່ງວ່າທ່ານເລືອກຖ້ຽວຖືກແລ້ວ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagantaa yeroo irraa baay'ee fagaatte. Marsaa sirrii filachuu kee mirkaneeffadhu."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਟਾਈਮ ਟੇਬਲ ਤੋਂ ਬਹੁਤ ਦੂਰ। ਚੈੱਕ ਕਰੋ ਕਿ ਤੁਸੀਂ ਸਹੀ ਫੇਰਾ ਚੁਣਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Duże odstępstwo od rozkładu. Sprawdź, czy wybrany kurs jest właściwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bem fora do horário. Verifique se escolheu a partida certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сильное отклонение от расписания. Проверьте, тот ли рейс вы выбрали."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E mamao ʻese mai le faʻasologa o taimi. Siaki pe saʻo le taʻamilosaga na e filifilia."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aad baad uga fog tahay jadwalka. Hubi inaad dooratay wareegga saxda ah."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mbali sana na ratiba. Hakikisha umechagua raundi sahihi."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ካብ መደብ ግዜ ብዙሕ ርሒቕኩም። ቅኑዕ ዙር ከም ዝመረጽኩም ኣረጋግጹ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сильно відхилилися від розкладу. Перевірте, чи ви вибрали правильний рейс."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lệch xa lịch trình. Hãy kiểm tra xem bạn đã chọn đúng chuyến chưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "与时刻表相差太多。请确认班次是否选对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "和時刻表差很多。請確認班次是否選對。"
          }
        }
      }
    },
