            "state" : "translated",
            "value" : "गाड़ी %1$@ · रूट %2$@"
          }
        }
      }
    },
    "Vehicle %@ is out of service. Pick another vehicle." : {
      "comment" : "Banner when the server refused a start because the vehicle was taken out of service: the fleet number, e.g. 'Vehicle 4317 is out of service. Pick another vehicle.'",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाड़ी %@ सेवा में नहीं है। कोई दूसरी गाड़ी चुनें।"
          }
        }
      }
    },
    "Vehicle %@, %@" : {
      "comment" : "VoiceOver: the vehicle's row of the stop list: its label or fleet number, then the status card's answer, e.g. 'Vehicle 4317, 3 min late'.",
      "localizations" : {
