          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na lē mafai ona faitau le tali a le server."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jawaabta server-ka lama akhrin karin."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jibu la seva halikusomeka."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không đọc được phản hồi của máy chủ."
          }
        }
      }
    },
    "Then tap %@" : {
      "comment" : "Welcome, screen 2: under 'Choose a run'. The name of the button that starts a trip, filled in from that button, e.g. 'Then tap Start trip'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tippen Sie dann auf „%@“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Luego toca “%@”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Napauta sitten “%@”"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saka i-tap ang “%@”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puis appuyez sur « %@ »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर ‘%@’ दबाएँ"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre sa, peze “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poi tocca “%@”"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Achiis “%@” tuqi"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potem kliknij „%@”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Depois toque em “%@”"
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ona paʻi lea i “%@”"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kadib taabo “%@”"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kisha gusa “%@”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau đó chạm vào “%@”"
          }
        }
      }
    },
    "Then tap %@. Riders see your vehicle from then on." : {
      "comment" : "Tip on 'Choose a run', under its title. The name of the start confirmation's button that starts the trip, filled in from that button, e.g. 'Then tap Start trip. Riders see your vehicle from then on.'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tippen Sie dann auf „%@“. Ab dann sehen Fahrgäste Ihr Fahrzeug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Luego toca %@. Desde ese momento, los pasajeros ven tu vehículo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Napauta sitten %@. Siitä lähtien matkustajat näkevät ajoneuvosi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saka i-tap ang %@. Mula noon, nakikita na ng mga pasahero ang sasakyan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puis appuyez sur %@. À partir de là, les passagers voient votre véhicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "फिर %@ दबाएँ। उसके बाद यात्री आपकी गाड़ी देख सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apre sa, peze %@. Depi lè sa a, pasaje yo wè machin ou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poi tocca %@. Da quel momento i passeggeri vedono il tuo veicolo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Achiis %@ tuqi. Sana booda imaltoonni konkolaataa kee argu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potem kliknij „%@”. Od tej chwili pasażerowie widzą twój pojazd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Depois toque em %@. A partir daí, os passageiros veem seu veículo."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ona paʻi lea i %@. Mai lea taimi e iloa atu ai e pasese lau taʻavale."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kadib taabo %@. Laga bilaabo markaas, rakaabku way arkaan gaarigaaga."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kisha gusa %@. Abiria wataona gari lako kuanzia hapo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau đó chạm vào %@. Từ lúc đó, hành khách sẽ thấy xe của bạn."
          }
        }
      }
    },
    "This link does not contain a server address the app can use." : {
      "comment" : "Title of the setup link alert when the link names no server address the app may use.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
