        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이전 운행을 아직 종료하지 못했어요. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
