    "Start a trip and riders see your vehicle on their map. End it when you finish." : {
      "comment" : "Welcome, screen 1: under the title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Starten Sie eine Fahrt, dann sehen Fahrgäste Ihr Fahrzeug auf ihrer Karte. Beenden Sie sie, wenn Sie fertig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inicia un viaje y los pasajeros ven tu vehículo en su mapa. Finalízalo cuando termines."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aloita matka, niin matkustajat näkevät ajoneuvosi kartallaan. Lopeta matka, kun olet valmis."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Magsimula ng trip at makikita ng mga pasahero ang sasakyan mo sa mapa nila. Tapusin ito kapag tapos ka na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Démarrez un trajet : les passagers voient votre véhicule sur leur carte. Terminez-le quand vous avez fini."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ट्रिप शुरू करें, तो यात्री अपने मैप पर आपकी गाड़ी देखते हैं। काम पूरा होने पर ट्रिप खत्म करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kòmanse yon vwayaj, epi pasaje yo wè machin ou sou kat yo. Fini vwayaj la lè ou fin travay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inizia un viaggio e i passeggeri vedono il tuo veicolo sulla loro mappa. Terminalo quando hai finito."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeroo imala jalqabdu, imaltoonni konkolaataa kee kaartaa isaanii irratti argu. Yommuu xumurtu imala xumuri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rozpocznij przejazd, a pasażerowie zobaczą twój pojazd na mapie. Na koniec go zakończ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inicie uma viagem e os passageiros veem seu veículo no mapa. Encerre a viagem quando terminar."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Amata se malaga ona iloa atu lea e pasese lau taʻavale i a lātou faʻafanua. Faʻaiʻu pe a uma."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bilow safar, rakaabkuna gaarigaaga ayay ku arkaan khariidaddooda. Markaad shaqada dhammayso, dhammee safarka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anza safari, na abiria wataona gari lako kwenye ramani zao. Ukimaliza kazi, maliza safari."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Khi bạn bắt đầu hành trình, hành khách sẽ thấy xe của bạn trên bản đồ. Kết thúc hành trình khi xong việc."
          }
        }
      }
    },
