        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Precise» ወሊዑ ይጽናሕ፣ ተጓዓዝቲ መኪና ኣብ ቅኑዕ ጎደና ምእንቲ ክርእይዋ"
