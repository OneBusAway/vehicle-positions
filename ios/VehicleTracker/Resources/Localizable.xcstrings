{
  "sourceLanguage": "en",
  "strings": {
    "%@, %lld reports sent": {
      "comment": "VoiceOver: the trip bar in one sentence for a route with no short name: the headsign, then how many reports have reached the server.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$#@reports@"
          },
          "substitutions": {
            "reports": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg report sent"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg reports sent"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld metres": {
      "comment": "VoiceOver: a distance in whole metres.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld metre"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld metres"
                }
              }
            }
          }
        }
      }
    },
    "%lld sent": {
      "comment": "Trip bar: how many reports have reached the server, e.g. '142 sent'.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sent"
