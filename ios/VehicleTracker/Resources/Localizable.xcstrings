    "Ask your agency's admin to check the schedule." : {
      "comment" : "Empty state text under 'The schedule has no routes'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bitten Sie den Admin Ihres Verkehrsbetriebs, den Fahrplan zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pídele al administrador de tu empresa que revise el horario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pyydä liikennöitsijäsi ylläpitäjää tarkistamaan aikataulu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sabihan ang admin ng kumpanya mo na i-check ang schedule."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demandez à l’administrateur de votre compagnie de vérifier les horaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अपनी एजेंसी के एडमिन से शेड्यूल जाँचने को कहें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mande administratè konpayi ou a tcheke orè a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiedi all'amministratore della tua azienda di controllare l'orario."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bulchaa dhaabbata keetii akka sagantaa ilaalu gaafadhu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poproś administratora przewoźnika o sprawdzenie rozkładu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Peça ao administrador da sua empresa para verificar a programação."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fai i le pule o lau kamupani e siaki le faʻasologa o taimi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ka codso maamulaha shirkaddaada inuu hubiyo jadwalka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mwombe msimamizi wa shirika lako aangalie ratiba."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nhờ quản trị viên của đơn vị vận hành kiểm tra lịch trình."
          }
        }
      }
    },
    "Ask your dispatcher" : {
      "comment" : "Problem line, after 'Reports refused': only dispatch can fix the assignment.",
      "localizations" : {
        "de" : {
