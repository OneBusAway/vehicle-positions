            "value" : "Seva haipokei ripoti za gari hili. Uliza mratibu wako."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Máy chủ không nhận vị trí của xe này. Hãy hỏi điều độ."
          }
        }
      }
    },
    "The server's reply could not be read." : {
      "comment" : "Shown only where no screen has its own words for a reply the app could not read, such as a Wi-Fi sign-in page answering in place of the server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Antwort des Servers konnte nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo leer la respuesta del servidor."
