        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ម៉ាស៊ីនមេមិនទទួលទីតាំងរបស់យានយន្តនេះទេ។ សូមសួរបន្ទប់បញ្ជា។"
