    "With CarPlay. Reports start when you open the app." : {
      "comment" : "Help, under 'Open the app on iPhone': the line shows when a trip started from the car cannot report until the app is opened on the phone.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ከCarPlay ለተጀመረ ጉዞ። መተግበሪያውን ሲከፍቱ ሪፖርት መላክ ይጀምራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "عند استخدام CarPlay. يبدأ إرسال التقارير عند فتح التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit CarPlay. Das Senden startet, wenn Sie die App öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con CarPlay. Los reportes empiezan cuando abras la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هنگام استفاده از CarPlay. با باز کردن برنامه، ارسال گزارش‌ها شروع می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CarPlayn kanssa. Raportointi alkaa, kun avaat sovelluksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gamit ang CarPlay. Magsisimula ang mga report kapag binuksan mo ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec CarPlay. L’envoi démarre quand vous ouvrez l’application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CarPlay से शुरू हुई ट्रिप में, ऐप खोलते ही रिपोर्ट शुरू हो जाती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ak CarPlay. Rapò yo kòmanse lè ou louvri aplikasyon an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con CarPlay. Le segnalazioni partono quando apri l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CarPlay 使用時。アプリを開くと送信が始まります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ពេលប្រើ CarPlay។ ការផ្ញើទីតាំងនឹងចាប់ផ្ដើម ពេលអ្នកបើកកម្មវិធី។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
