                  "value" : "सभी रूट · %lld"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "सभी रूट · %lld"
                }
              }
            }
          }
        }
      }
    },
    "All vehicles" : {
      "comment" : "Section header over the rest of the driver's assigned vehicles.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी गाड़ियाँ"
          }
        }
      }
    },
    "Allow location" : {
      "comment" : "Welcome, screen 3: the first thing a trip needs.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोकेशन की अनुमति दें"
          }
        }
      }
    },
    "Allow location on iPhone" : {
      "comment" : "CarPlay alert when a start from the car got no answer to the location prompt, which shows only on the iPhone.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone पर लोकेशन की अनुमति दें"
          }
        }
      }
    },
    "Allowed" : {
      "comment" : "At the end of a checklist row that iOS allowed.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति है"
          }
        }
      }
    },
    "An operator has to load one before trips can start. Tell your agency's admin." : {
      "comment" : "Empty state text under 'No schedule on this server yet'.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रिप शुरू हो सकें, इसके लिए पहले किसी ऑपरेटर को शेड्यूल लोड करना होगा। अपनी एजेंसी के एडमिन को बताएँ।"
          }
        }
      }
    },
    "Another driver has a trip running on vehicle %@. Pick another vehicle or ask your dispatcher." : {
      "comment" : "Banner when the server refused a start because another driver has a trip running on the vehicle: the fleet number, e.g. 'Another driver has a trip running on vehicle 4317. Pick another vehicle or ask your dispatcher.'",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
