    "Keep Precise on, so riders see the right street" : {
      "comment" : "Welcome, screen 3: under 'Allow location'. Precise is iOS's name for precise location.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Precise» እንደበራ ይተዉት፣ ተሳፋሪዎች መኪናውን በትክክለኛው መንገድ ላይ እንዲያዩ"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أبقِ خيار الدقيق مشغلًا، ليرى الركاب الشارع الصحيح"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Genau“ eingeschaltet lassen, damit Fahrgäste die richtige Straße sehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantén “Precisa” activada para que los pasajeros te vean en la calle correcta"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کلید Precise را روشن نگه دارید تا مسافران خیابان درست را ببینند"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pidä “Tarkka” päällä, jotta matkustajat näkevät oikean kadun"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Panatilihing naka-on ang Precise, para makita ng mga pasahero ang tamang kalsada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laissez Position exacte activée pour que les passagers voient la bonne rue"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘सटीक’ चालू रखें, ताकि यात्रियों को सही सड़क दिखे"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kite Precise aktive, pou pasaje yo wè bon lari a"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tieni attiva l'opzione Esatta, così i passeggeri ti vedono sulla strada giusta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "正確な位置情報をオンのままにすると、乗客の地図で正しい道路に表示されます"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ទុក Precise ឱ្យបើក ដើម្បីឱ្យអ្នកដំណើរឃើញយានយន្តនៅលើផ្លូវត្រឹមត្រូវ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "정확한 위치를 켜 두면 승객 지도에서 차량이 맞는 도로에 보여요"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ເປີດ Precise ໄວ້, ເພື່ອໃຫ້ຜູ້ໂດຍສານເຫັນລົດຢູ່ຖະໜົນທີ່ຖືກຕ້ອງ"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Precise” banaa dhiisi, akka imaltoonni karaa sirrii arganiif"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ਸਟੀਕ” ਚਾਲੂ ਰੱਖੋ, ਤਾਂ ਜੋ ਸਵਾਰੀਆਂ ਨੂੰ ਸਹੀ ਸੜਕ ਦਿਸੇ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
