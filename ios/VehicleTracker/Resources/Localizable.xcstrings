    "So riders see the vehicle at the right stop" : {
      "comment" : "Checklist: why the app needs precise location.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Damit Fahrgäste das Fahrzeug an der richtigen Haltestelle sehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para que los pasajeros vean el vehículo en la parada correcta"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jotta matkustajat näkevät ajoneuvon oikealla pysäkillä"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para makita ng mga pasahero ang sasakyan sa tamang hintuan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour que les passagers voient le véhicule au bon arrêt"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ताकि यात्री गाड़ी को सही स्टॉप पर देखें"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pou pasaje yo wè machin nan sou bon arè a"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Così i passeggeri vedono il veicolo alla fermata giusta"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Akka imaltoonni konkolaataa buufata sirrii irratti arganiif"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aby pasażerowie widzieli pojazd na właściwym przystanku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para os passageiros verem o veículo na parada certa"
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ina ʻia iloa atu e pasese le taʻavale i le taofiga saʻo"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si rakaabku gaariga ugu arkaan joogsiga saxda ah"
