    "Far from the timetable. Check you chose the right run." : {
      "comment" : "Help, under 'Off schedule'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Weit weg vom Fahrplan. Prüfen Sie, ob Sie den richtigen Kurs gewählt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muy lejos del horario. Revisa que hayas elegido la salida correcta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kaukana aikataulusta. Tarkista, että valitsit oikean vuoron."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Malayo sa schedule. I-check kung tama ang biyaheng pinili mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Loin de l’horaire. Vérifiez que vous avez choisi la bonne course."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टाइम टेबल से बहुत दूर। जाँच लें कि आपने सही फेरा चुना है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Byen lwen orè a. Tcheke si ou chwazi bon kous la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Molto fuori orario. Controlla di aver scelto la corsa giusta."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sagantaa yeroo irraa baay'ee fagaatte. Marsaa sirrii filachuu kee mirkaneeffadhu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Duże odstępstwo od rozkładu. Sprawdź, czy wybrany kurs jest właściwy."
