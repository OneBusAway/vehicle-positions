      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählen Sie sie aus und tippen Sie dann auf „%@“. Beenden Sie die Fahrt, wenn Sie fertig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elígelos y luego toca “%@”. Finaliza el viaje cuando termines."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Valitse ne ja napauta sitten “%@”. Lopeta matka, kun olet valmis."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Piliin ang mga ito, saka i-tap ang “%@”. Tapusin ang trip kapag tapos ka na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez-les, puis appuyez sur « %@ ». Terminez le trajet quand vous avez fini."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इन्हें चुनें, फिर ‘%@’ दबाएँ। काम पूरा होने पर ट्रिप खत्म करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chwazi yo, epi peze “%@”. Fini vwayaj la lè ou fin travay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sceglili, poi tocca “%@”. Termina il viaggio quando hai finito."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isaan filadhu, achiis “%@” tuqi. Yommuu xumurtu imala xumuri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz je, potem kliknij „%@”. Na koniec zakończ przejazd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha os três e depois toque em “%@”. Encerre a viagem quando terminar."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filifili, ona paʻi lea i “%@”. Faʻaiʻu le malaga pe a uma."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kuwan dooro, kadibna taabo “%@”. Markaad shaqada dhammayso, dhammee safarka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vichague, kisha gusa “%@”. Ukimaliza kazi, maliza safari."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chọn các mục này, rồi chạm vào “%@”. Kết thúc hành trình khi xong việc."
          }
        }
      }
    },
