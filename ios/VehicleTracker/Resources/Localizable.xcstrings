    },
    "Ask your dispatcher to assign one, then check again." : {
      "comment" : "Empty state text under 'No vehicles are assigned to you'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bitten Sie die Leitstelle, Ihnen eines zuzuweisen, und schauen Sie dann noch einmal nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pídele a tu despachador que te asigne uno y vuelve a revisar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pyydä ajojärjestelijää määrittämään sinulle ajoneuvo ja tarkista sitten uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sabihan ang dispatcher mo na mag-assign ng isa, saka i-check ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demandez à votre régulateur de vous en attribuer un, puis vérifiez à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कंट्रोल रूम से एक गाड़ी देने को कहें, फिर दोबारा जाँचें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mande sant kontwòl la ba ou youn, epi tcheke ankò."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chiedi alla centrale di assegnartene uno, poi controlla di nuovo."
