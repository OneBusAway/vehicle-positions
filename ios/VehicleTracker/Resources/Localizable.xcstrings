    "Pick another route, or check again tomorrow." : {
      "comment" : "Empty state text under 'No runs on route … today'.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ሌላ መስመር ይምረጡ፣ ወይም ነገ እንደገና ያረጋግጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اختر خطًا آخر، أو تحقق مرة أخرى غدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wählen Sie eine andere Linie oder schauen Sie morgen noch einmal nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elige otra ruta o vuelve a revisar mañana."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "مسیر دیگری انتخاب کنید، یا فردا دوباره بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Valitse toinen linja tai tarkista uudelleen huomenna."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pumili ng ibang route, o i-check ulit bukas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Choisissez une autre ligne, ou revenez demain."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कोई दूसरा रूट चुनें, या कल फिर देखें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chwazi yon lòt wout, oswa tcheke ankò demen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scegli un'altra linea o controlla di nuovo domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "別の路線を選ぶか、明日もう一度確認してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "សូមជ្រើសរើសខ្សែផ្សេង ឬពិនិត្យម្ដងទៀតនៅថ្ងៃស្អែក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다른 노선을 고르거나 내일 다시 확인하세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ເລືອກສາຍອື່ນ ຫຼື ກວດເບິ່ງອີກຄັ້ງມື້ອື່ນ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daandii biraa filadhu, yookaan bori irra deebi'ii ilaali."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਕੋਈ ਹੋਰ ਰੂਟ ਚੁਣੋ, ਜਾਂ ਕੱਲ੍ਹ ਦੁਬਾਰਾ ਚੈੱਕ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierz inną linię albo sprawdź ponownie jutro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escolha outra linha ou verifique novamente amanhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Выберите другой маршрут или проверьте снова завтра."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Filifili se isi auala, poʻo toe siaki taeao."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dooro khad kale, ama berri mar kale hubi."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chagua njia nyingine, au uangalie tena kesho."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ካልእ መስመር ምረጹ፣ ወይ ጽባሕ ደጊምኩም ኣረጋግጹ።"
