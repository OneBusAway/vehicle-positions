        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Shaashaddu way shidan tahay inta uu korontada ku xiran yahay"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skrini hubaki ikiwaka wakati simu inachaji"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Màn hình luôn sáng khi đang sạc"
          }
        }
      }
    },
    "The server didn't confirm the end. Check your signal and try again, or stop reporting on this phone now." : {
      "comment" : "Message of the 'Trip not ended yet' alert.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Server hat das Ende nicht bestätigt. Prüfen Sie Ihren Empfang und versuchen Sie es noch einmal, oder beenden Sie das Senden jetzt auf diesem Handy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El servidor no confirmó el fin del viaje. Revisa tu señal e inténtalo de nuevo, o deja de reportar en este teléfono ahora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Palvelin ei vahvistanut lopetusta. Tarkista kuuluvuus ja yritä uudelleen tai lopeta raportointi tällä puhelimella nyt."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi kinumpirma ng server ang pagtatapos. I-check ang signal mo at subukan ulit, o itigil na ngayon ang pag-report sa phone na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le serveur n’a pas confirmé la fin du trajet. Vérifiez votre réseau et réessayez, ou arrêtez l’envoi sur ce téléphone maintenant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सर्वर ने ट्रिप खत्म होने की पुष्टि नहीं की। अपना सिग्नल जाँचें और फिर से कोशिश करें, या अभी इस फ़ोन पर रिपोर्ट भेजना बंद करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sèvè a pa konfime vwayaj la fini. Tcheke rezo ou epi eseye ankò, oswa sispann voye rapò sou telefòn sa a kounye a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il server non ha confermato la fine. Controlla il segnale e riprova, oppure interrompi ora l'invio su questo telefono."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sarvariin xumura imalaa hin mirkaneessine. Neetworkii kee ilaalii irra deebi'ii yaali, yookaan amma bilbila kana irratti gabaasuu dhaabi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serwer nie potwierdził zakończenia. Sprawdź zasięg i spróbuj ponownie albo od razu zatrzymaj raporty na tym telefonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O servidor não confirmou o encerramento. Verifique seu sinal e tente novamente, ou pare o envio de posições neste celular agora."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leʻi faʻamaonia e le server le faʻaiʻuga. Siaki lau fesoʻotaʻiga ona toe taumafai lea, poʻo taofi loa lipoti i lenei telefoni."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Server-ku ma xaqiijin dhammaadka. Hubi shabakaddaada oo isku day mar kale, ama hadda jooji warbixinta taleefankan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seva haikuthibitisha kuwa safari imeisha. Angalia mtandao wako kisha ujaribu tena, au acha kuripoti kwenye simu hii sasa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Máy chủ chưa xác nhận hành trình đã kết thúc. Hãy kiểm tra sóng rồi thử lại, hoặc ngừng gửi vị trí trên điện thoại này ngay."
          }
        }
      }
    },
    "The server didn't confirm the trip ended. Try again, or end it on this phone only." : {
