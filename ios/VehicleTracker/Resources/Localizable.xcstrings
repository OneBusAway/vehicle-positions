        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E mamao ʻese mai le faʻasologa o taimi. Siaki pe saʻo le taʻamilosaga na e filifilia."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aad baad uga fog tahay jadwalka. Hubi inaad dooratay wareegga saxda ah."
