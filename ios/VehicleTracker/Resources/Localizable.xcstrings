    "A problem on the server. Tell your dispatcher." : {
      "comment" : "Help, under 'Server error'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Problem auf dem Server. Informieren Sie die Leitstelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un problema en el servidor. Avísale a tu despachador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ongelma palvelimella. Kerro asiasta ajojärjestelijälle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "May problema sa server. Sabihan ang dispatcher mo."
