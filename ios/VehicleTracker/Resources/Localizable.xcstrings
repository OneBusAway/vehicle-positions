        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सर्वर में दिक्कत है। कंट्रोल रूम को बताएँ।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gen yon pwoblèm nan sèvè a. Fè sant kontwòl la konnen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un problema sul server. Avvisa la centrale."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sarvarii irratti rakkoon uumame. To'ataa kee beeksisi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Problem na serwerze. Powiadom dyspozytora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um problema no servidor. Avise a central."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O se faʻafitauli i le server. Taʻu i le ofisa."
