    "Use https://. Plain http:// is allowed only for localhost, 127.0.0.1 or a .local host." : {
      "comment" : "Under the server field when the address is plain http to a host the app won't send a password to.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwenden Sie https://. Einfaches http:// ist nur für localhost, 127.0.0.1 oder einen .local-Host erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa https://. Solo se permite http:// para localhost, 127.0.0.1 o un host .local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Käytä https://-osoitetta. Pelkkä http:// on sallittu vain, kun osoite on localhost, 127.0.0.1 tai .local-päätteinen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gumamit ng https://. Sa localhost, 127.0.0.1 o isang .local na host lang pinapayagan ang http://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisez https://. Le simple http:// n’est autorisé que pour localhost, 127.0.0.1 ou un hôte .local."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "https:// इस्तेमाल करें। सादा http:// सिर्फ़ localhost, 127.0.0.1 या .local होस्ट के लिए चलता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sèvi ak https://. Ou ka sèvi ak http:// sèlman pou localhost, 127.0.0.1 oswa yon adrès .local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa https://. Il semplice http:// è consentito solo per localhost, 127.0.0.1 o un host .local."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teessoo https:// fayyadami. Teessoon http:// localhost, 127.0.0.1 yookaan teessoo .local qofaaf hayyamama."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Użyj https://. Zwykły http:// jest dozwolony tylko dla localhost, 127.0.0.1 lub hosta .local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Use https://. O http:// só é permitido para localhost, 127.0.0.1 ou um host .local."
