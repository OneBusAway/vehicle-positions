          "stringUnit" : {
            "state" : "translated",
            "value" : "इस एजेंसी का अपना ड्राइवर अकाउंट इस्तेमाल करें।"
          }
        }
      }
    },
    "Vehicle %@" : {
      "comment" : "Resume card: the vehicle's fleet number, e.g. 'Vehicle 4317'.\nSubtitle of the route screen: the fleet number of the vehicle the driver chose, e.g. 'Vehicle 4317'.\nVoiceOver: the vehicle's row of the stop list before the first fix, and the vehicle on the map: its label or fleet number, e.g. 'Vehicle 4317'.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाड़ी %@"
          }
        }
      }
    },
    "Vehicle %@ · Route %@" : {
      "comment" : "Subtitle of the run screen: the fleet number of the vehicle, then the route's number, e.g. 'Vehicle 4317 · Route 7'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vehicle %1$@ · Route %2$@"
