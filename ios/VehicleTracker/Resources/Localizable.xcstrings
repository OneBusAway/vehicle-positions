    "%@. Off schedule, is this the right run? Next stop %@, %@" : {
      "comment" : "VoiceOver: the status card in one sentence while off schedule. The card's answer, then the next stop's name and its scheduled time, e.g. '20 min late. Off schedule, is this the right run? Next stop 3rd Ave & Seneca St, 7:18 AM'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Außerhalb des Fahrplans. Ist das der richtige Kurs? Nächster Halt: %2$@, %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Off schedule, is this the right run? Next stop %2$@, %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Fuera de horario, ¿es la salida correcta? Próxima parada: %2$@, %3$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Kaukana aikataulusta. Onko tämä oikea vuoro? Seuraava pysäkki %2$@, %3$@"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Wala sa schedule, tama ba ang biyaheng ito? Susunod na hintuan %2$@, %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Hors horaire, est-ce la bonne course ? Prochain arrêt : %2$@, %3$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@। शेड्यूल से बाहर, क्या यह सही फेरा है? अगला स्टॉप %2$@, %3$@"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Andeyò orè, se bon kous la? Pwochen arè %2$@, %3$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Fuori orario, è la corsa giusta? Prossima fermata %2$@, %3$@"
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Sagantaa ala, marsaan kun sirriidhaa? Buufata itti aanu %2$@, %3$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Poza rozkładem, czy to właściwy kurs? Następny przystanek: %2$@, %3$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Fora do horário, esta é a partida certa? Próxima parada: %2$@, %3$@"
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. ʻEse mai le faʻasologa, pe saʻo lenei taʻamilosaga? Taofiga e sosoʻo ai %2$@, %3$@"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Jadwalka ka baxsan, ma dooratay wareegga saxda ah? Joogsiga xiga %2$@, %3$@"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Nje ya ratiba, je, hii ndiyo raundi sahihi? Kituo kijacho %2$@, %3$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@. Lệch lịch trình, đây có đúng chuyến không? Điểm dừng tiếp theo là %2$@, %3$@"
          }
        }
      }
    },
