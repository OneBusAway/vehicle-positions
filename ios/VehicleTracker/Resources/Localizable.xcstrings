    "Keep driving. Reports start again with the signal." : {
      "comment" : "Help, under 'No connection'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fahren Sie weiter. Sobald der Empfang zurück ist, wird wieder gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sigue manejando. Los reportes se reanudan cuando vuelva la señal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jatka ajoa. Raportointi jatkuu, kun kenttä palaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tuloy lang sa pagmamaneho. Magsisimula ulit ang mga report pagbalik ng signal."
