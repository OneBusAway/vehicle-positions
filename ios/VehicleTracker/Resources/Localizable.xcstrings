{
  "sourceLanguage" : "en",
  "strings" : {
    "%.1f kilometres" : {
      "comment" : "VoiceOver: a distance in kilometres to one decimal place, read in place of '1.3 km', e.g. '1.3 kilometres'."
    },
    "%.1f km" : {
      "comment" : "A distance of a kilometre or more, in kilometres to one decimal place with the short unit: to the next stop on the status card and in CarPlay, and how far off the route. E.g. '1.3 km'."
    },
    "%@ · %@" : {
      "comment" : "Two facts on one line: a stop's scheduled time then the distance to it, or the run's start time then the vehicle.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "VoiceOver: the welcome's card for a stopped trip in one announcement: its title, the Resume screen's question, then what to do, e.g. 'Resume your trip? Open the app and tap Resume trip.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ → %@" : {
      "comment" : "Under the run board's date, and under a run in CarPlay: the direction's first stop, then its last stop, e.g. 'Northgate Station → Downtown Seattle'. The arrow points from the first to the last; turn it for a language written right to left.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ → %2$@"
          }
        }
      }
    },
    "%@ run" : {
      "comment" : "Resume card: the run's first departure in the agency's zone, e.g. '6:58 AM run'."
    },
    "%@ run · %@" : {
      "comment" : "Status card line 2 while waiting for GPS: the run's start time in the agency's zone, then the vehicle, e.g. '6:58 AM run · 4317'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ run · %2$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "VoiceOver label of a vehicle tile: the fleet number, then the label the agency gave the vehicle, e.g. '4317, Airport shuttle'.\nVoiceOver: a stop list row for a stop still ahead: the stop's name, then its scheduled time, e.g. 'Pine St & 4th Ave, 7:24 AM'.\nVoiceOver: the problem line in one sentence: what happened, then what it means or what to do, e.g. 'No connection, Riders can't see you'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %lld reports sent" : {
      "comment" : "VoiceOver: the trip bar in one sentence for a route with no short name: the headsign, then how many reports have reached the server, e.g. 'Downtown Seattle, 142 reports sent'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$#@reports@"
          },
          "substitutions" : {
            "reports" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg report sent"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg reports sent"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, allowed." : {
      "comment" : "VoiceOver: said once when iOS allows a checklist row while the checklist shows: the row's title, e.g. 'Location, allowed.'"
    },
    "%@, last stop, %@" : {
      "comment" : "VoiceOver: a stop list row for the end of the line: the stop's name, then its scheduled time, e.g. 'Downtown Transit Center, last stop, 7:52 AM'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, last stop, %2$@"
          }
        }
      }
    },
    "%@, next stop, %@" : {
      "comment" : "VoiceOver: a stop list row for the next stop: the stop's name, then its scheduled time, e.g. '3rd Ave & Seneca St, next stop, 7:18 AM'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, next stop, %2$@"
          }
        }
      }
    },
    "%@, passed, %@" : {
      "comment" : "VoiceOver: a stop list row for a stop the vehicle has passed: the stop's name, then its scheduled time, e.g. 'Northgate Station, passed, 6:58 AM'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, passed, %2$@"
          }
        }
      }
    },
    "%@. %@." : {
      "comment" : "VoiceOver: a card or a row of the welcome in one sentence: its title, then the line under it, e.g. 'Choose your vehicle. The number on the vehicle.'\nVoiceOver: a checklist row: its title, then why the app needs it or what went wrong, e.g. 'Precise location. Only approximate was allowed.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@."
          }
        }
      }
    },
    "%@. %@. Allowed." : {
      "comment" : "VoiceOver: a checklist row iOS allowed: its title, then why the app needs it, e.g. 'Precise location. So riders see the vehicle at the right stop. Allowed.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@. Allowed."
          }
        }
      }
    },
    "%@. %@. Next." : {
      "comment" : "VoiceOver: a checklist row that Continue asks about next: its title, then why the app needs it, e.g. 'Location. So the app knows where the vehicle is. Next.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@. Next."
          }
        }
      }
    },
    "%@. Next stop %@, %@" : {
      "comment" : "VoiceOver: the status card in one sentence, with no distance. The card's answer, then the next stop's name and its scheduled time, e.g. '3 min late. Next stop 3rd Ave & Seneca St, 7:18 AM'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Next stop %2$@, %3$@"
          }
        }
      }
    },
    "%@. Next stop %@, %@, %@" : {
      "comment" : "VoiceOver: the status card in one sentence. The card's answer, then the next stop's name, its scheduled time and the distance to it, e.g. 'On time. Next stop 3rd Ave & Seneca St, 7:18 AM, 232 metres'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Next stop %2$@, %3$@, %4$@"
          }
        }
      }
    },
    "%@. Off schedule, is this the right run? Next stop %@, %@" : {
      "comment" : "VoiceOver: the status card in one sentence while off schedule. The card's answer, then the next stop's name and its scheduled time, e.g. '20 min late. Off schedule, is this the right run? Next stop 3rd Ave & Seneca St, 7:18 AM'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Off schedule, is this the right run? Next stop %2$@, %3$@"
          }
        }
      }
    },
    "%lld m" : {
      "comment" : "A distance under a kilometre, in whole metres with the short unit: to the next stop on the status card and in CarPlay, and how far off the route, as in 'Off route · 120 m'. E.g. '350 m'."
