        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No tienes asignado el vehículo %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoneuvoa %@ ei ole määritetty sinulle."
