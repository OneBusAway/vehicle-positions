    "The server didn't confirm the end. Check your signal and try again, or stop reporting on this phone now." : {
      "comment" : "Message of the 'Trip not ended yet' alert.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ሰርቨሩ ጉዞው መጠናቀቁን አላረጋገጠም። ኔትወርክዎን አረጋግጠው እንደገና ይሞክሩ፣ ወይም አሁን በዚህ ስልክ ሪፖርት መላክ ያቁሙ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يؤكد الخادم إنهاء الرحلة. تحقق من الإشارة وحاول مرة أخرى، أو أوقف الإرسال من هذا الهاتف الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Server hat das Ende nicht bestätigt. Prüfen Sie Ihren Empfang und versuchen Sie es noch einmal, oder beenden Sie das Senden jetzt auf diesem Handy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El servidor no confirmó el fin del viaje. Revisa tu señal e inténtalo de nuevo, o deja de reportar en este teléfono ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرور پایان سفر را تأیید نکرد. آنتن گوشی را بررسی کنید و دوباره تلاش کنید، یا همین حالا ارسال گزارش را در این گوشی متوقف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Palvelin ei vahvistanut lopetusta. Tarkista kuuluvuus ja yritä uudelleen tai lopeta raportointi tällä puhelimella nyt."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi kinumpirma ng server ang pagtatapos. I-check ang signal mo at subukan ulit, o itigil na ngayon ang pag-report sa phone na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le serveur n’a pas confirmé la fin du trajet. Vérifiez votre réseau et réessayez, ou arrêtez l’envoi sur ce téléphone maintenant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सर्वर ने ट्रिप खत्म होने की पुष्टि नहीं की। अपना सिग्नल जाँचें और फिर से कोशिश करें, या अभी इस फ़ोन पर रिपोर्ट भेजना बंद करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sèvè a pa konfime vwayaj la fini. Tcheke rezo ou epi eseye ankò, oswa sispann voye rapò sou telefòn sa a kounye a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il server non ha confermato la fine. Controlla il segnale e riprova, oppure interrompi ora l'invio su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "サーバーから終了の確認がありませんでした。電波状況を確認してもう一度お試しいただくか、このスマートフォンでの送信を今すぐ止めてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ម៉ាស៊ីនមេមិនបានបញ្ជាក់ការបញ្ចប់ទេ។ សូមពិនិត្យសញ្ញា ហើយព្យាយាមម្ដងទៀត ឬឈប់ផ្ញើទីតាំងពីទូរសព្ទនេះឥឡូវ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "서버가 종료를 확인하지 않았어요. 신호를 확인하고 다시 시도하거나, 지금 이 휴대전화에서 위치 전송을 멈추세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ເຊີບເວີບໍ່ໄດ້ຢືນຢັນວ່າຈົບແລ້ວ. ກວດເບິ່ງສັນຍານ ແລ້ວລອງໃໝ່ ຫຼື ຢຸດລາຍງານໃນໂທລະສັບນີ້ດຽວນີ້."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sarvariin xumura imalaa hin mirkaneessine. Neetworkii kee ilaalii irra deebi'ii yaali, yookaan amma bilbila kana irratti gabaasuu dhaabi."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਸਰਵਰ ਨੇ ਟ੍ਰਿਪ ਖਤਮ ਹੋਣ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕੀਤੀ। ਆਪਣਾ ਸਿਗਨਲ ਚੈੱਕ ਕਰਕੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਹੁਣੇ ਇਸ ਫ਼ੋਨ 'ਤੇ ਰਿਪੋਰਟਿੰਗ ਬੰਦ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serwer nie potwierdził zakończenia. Sprawdź zasięg i spróbuj ponownie albo od razu zatrzymaj raporty na tym telefonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O servidor não confirmou o encerramento. Verifique seu sinal e tente novamente, ou pare o envio de posições neste celular agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сервер не подтвердил завершение. Проверьте сигнал и попробуйте ещё раз или прямо сейчас остановите отправку на этом телефоне."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leʻi faʻamaonia e le server le faʻaiʻuga. Siaki lau fesoʻotaʻiga ona toe taumafai lea, poʻo taofi loa lipoti i lenei telefoni."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Server-ku ma xaqiijin dhammaadka. Hubi shabakaddaada oo isku day mar kale, ama hadda jooji warbixinta taleefankan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seva haikuthibitisha kuwa safari imeisha. Angalia mtandao wako kisha ujaribu tena, au acha kuripoti kwenye simu hii sasa."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ሰርቨር ምብቃዕ ጉዕዞ ኣየረጋገጸን። ሲግናልኩም ኣረጋጊጽኩም ደጊምኩም ፈትኑ፣ ወይ ሕጂ ኣብዚ ተሌፎን ጸብጻብ ምስዳድ ደው ኣብሉ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сервер не підтвердив завершення. Перевірте сигнал і спробуйте ще раз або зараз зупиніть надсилання звітів з цього телефона."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Máy chủ chưa xác nhận hành trình đã kết thúc. Hãy kiểm tra sóng rồi thử lại, hoặc ngừng gửi vị trí trên điện thoại này ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "服务器未确认结束。请检查信号后重试，或现在就停止此手机的上报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "伺服器沒有確認行程已結束。請檢查訊號後再試一次，或現在就停止這支手機的回報。"
          }
        }
      }
    },
    "The server didn't confirm the trip ended. Try again, or end it on this phone only." : {
      "comment" : "Banner on the Resume screen once the server did not confirm the end; the buttons then say Try again and End on this phone.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ሰርቨሩ ጉዞው መጠናቀቁን አላረጋገጠም። እንደገና ይሞክሩ፣ ወይም በዚህ ስልክ ላይ ብቻ ይጨርሱት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لم يؤكد الخادم انتهاء الرحلة. حاول مرة أخرى، أو أنهِها على هذا الهاتف فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Server hat das Ende der Fahrt nicht bestätigt. Versuchen Sie es noch einmal, oder beenden Sie sie nur auf diesem Handy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El servidor no confirmó que el viaje finalizó. Inténtalo de nuevo o finalízalo solo en este teléfono."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سرور پایان سفر را تأیید نکرد. دوباره تلاش کنید، یا آن را فقط در این گوشی پایان دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Palvelin ei vahvistanut matkan päättymistä. Yritä uudelleen tai lopeta matka vain tällä puhelimella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi kinumpirma ng server na natapos ang trip. Subukan ulit, o tapusin ito sa phone na ito lang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le serveur n’a pas confirmé la fin du trajet. Réessayez, ou terminez-le sur ce téléphone seulement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सर्वर ने ट्रिप खत्म होने की पुष्टि नहीं की। फिर से कोशिश करें, या इसे सिर्फ़ इस फ़ोन पर खत्म करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sèvè a pa konfime vwayaj la fini. Eseye ankò, oswa fini l sou telefòn sa a sèlman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il server non ha confermato la fine del viaggio. Riprova o terminalo solo su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "サーバーから運行終了の確認がありませんでした。もう一度お試しいただくか、このスマートフォンだけで終了してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ម៉ាស៊ីនមេមិនបានបញ្ជាក់ថាដំណើរបានបញ្ចប់ទេ។ សូមព្យាយាមម្ដងទៀត ឬបញ្ចប់វាតែលើទូរសព្ទនេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "서버가 운행 종료를 확인하지 않았어요. 다시 시도하거나 이 휴대전화에서만 종료하세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ເຊີບເວີບໍ່ໄດ້ຢືນຢັນວ່າການເດີນທາງຈົບແລ້ວ. ລອງໃໝ່ ຫຼື ຈົບສະເພາະໃນໂທລະສັບນີ້."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sarvariin xumura imalaa hin mirkaneessine. Irra deebi'ii yaali, yookaan bilbila kana qofa irratti xumuri."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਸਰਵਰ ਨੇ ਟ੍ਰਿਪ ਖਤਮ ਹੋਣ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕੀਤੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਇਸਨੂੰ ਸਿਰਫ਼ ਇਸ ਫ਼ੋਨ 'ਤੇ ਖਤਮ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serwer nie potwierdził zakończenia przejazdu. Spróbuj ponownie albo zakończ go tylko na tym telefonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O servidor não confirmou o encerramento da viagem. Tente novamente ou encerre só neste celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сервер не подтвердил завершение поездки. Попробуйте ещё раз или завершите её только на этом телефоне."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leʻi faʻamaonia e le server ʻua uma le malaga. Toe taumafai, poʻo faʻaiʻu naʻo i lenei telefoni."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Server-ku ma xaqiijin in safarku dhammaaday. Isku day mar kale, ama ku dhammee taleefankan oo keliya."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seva haikuthibitisha kuwa safari imeisha. Jaribu tena, au imalize kwenye simu hii pekee."
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ሰርቨር ምብቃዕ ጉዕዞ ኣየረጋገጸን። ደጊምኩም ፈትኑ፣ ወይ ኣብዚ ተሌፎን ጥራይ ኣብቅዕዎ።"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сервер не підтвердив завершення поїздки. Спробуйте ще раз або завершіть її лише на цьому телефоні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Máy chủ chưa xác nhận hành trình đã kết thúc. Hãy thử lại, hoặc chỉ kết thúc trên điện thoại này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "服务器未确认行程已结束。请重试，或仅在此手机上结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "伺服器沒有確認行程已結束。請再試一次，或只在這支手機上結束。"
