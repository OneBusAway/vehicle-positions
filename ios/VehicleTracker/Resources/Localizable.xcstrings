          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ເມື່ອໃຊ້ CarPlay. ການລາຍງານຈະເລີ່ມເມື່ອທ່ານເປີດແອັບ."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
