        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo link non contiene un indirizzo del server che l'app possa usare."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liinkiin kun teessoo sarvarii appiin itti fayyadamuu danda'u hin qabu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ten link nie zawiera adresu serwera, którego aplikacja może użyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este link não tem um endereço de servidor que o app possa usar."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leai i lenei soʻotaga se tuatusi server e mafai e le app ona faʻaaogā."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Linkigan kuma jiro cinwaan server oo app-ku isticmaali karo."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiungo hiki hakina anwani ya seva ambayo programu inaweza kutumia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đường liên kết này không có địa chỉ máy chủ mà ứng dụng dùng được."
          }
        }
      }
    },
    "This number grows while riders can see you. With no signal, keep driving." : {
      "comment" : "Tip on the trip bar's sent count, under its title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese Zahl steigt, solange Fahrgäste Sie sehen können. Ohne Empfang fahren Sie einfach weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este número sube mientras los pasajeros pueden verte. Sin señal, sigue manejando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Luku kasvaa niin kauan kuin matkustajat näkevät sinut. Jos kenttää ei ole, jatka ajoa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lumalaki ang numerong ito habang nakikita ka ng mga pasahero. Kung walang signal, tuloy lang sa pagmamaneho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce nombre augmente tant que les passagers vous voient. Sans réseau, continuez à rouler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जब तक यात्री आपको देख सकते हैं, यह नंबर बढ़ता रहता है। सिग्नल न हो, तो गाड़ी चलाते रहें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nimewo sa a ap monte toutotan pasaje yo ka wè w. Si pa gen rezo, kontinye kondi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo numero cresce mentre i passeggeri ti vedono. Senza segnale, continua a guidare."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hamma imaltoonni si arguu danda'anitti lakkoofsi kun ni dabala. Yoo neetworkiin hin jirre, konkolaachisuu itti fufi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta liczba rośnie, gdy pasażerowie cię widzą. Przy braku zasięgu jedź dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este número aumenta enquanto os passageiros veem você. Sem sinal, continue dirigindo."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E siʻi aʻe lenei numera aʻo iloa atu ʻoe e pasese. Afai e leai se fesoʻotaʻiga, ʻave pea le taʻavale."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lambarkani wuu kordhayaa inta rakaabku ku arki karaan. Haddii aanay shabakad jirin, gaariga sii wad."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nambari hii huongezeka wakati abiria wanaweza kukuona. Kukiwa hakuna mtandao, endelea kuendesha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con số này tăng dần khi hành khách thấy được bạn. Khi mất sóng, cứ tiếp tục lái."
          }
        }
      }
    },
    "This phone is signed in to %@. The link was not used." : {
      "comment" : "Title of the setup link alert when the phone is already signed in, so it keeps its server: the host of that server, e.g. 'This phone is signed in to tracker.example.org. The link was not used.'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Handy ist bei %@ angemeldet. Der Link wurde nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este teléfono tiene la sesión iniciada en %@. No se usó el enlace."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tämä puhelin on kirjautunut palvelimeen %@. Linkkiä ei käytetty."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Naka-sign in ang phone na ito sa %@. Hindi ginamit ang link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce téléphone est connecté à %@. Le lien n’a pas été utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यह फ़ोन %@ में साइन इन है। लिंक इस्तेमाल नहीं हुआ।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Telefòn sa a konekte sou %@. Nou pa t sèvi ak lyen an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo telefono ha eseguito l'accesso a %@. Il link non è stato usato."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bilbilli kun %@ irratti seenee jira. Liinkiin kun hojii irra hin oolle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ten telefon jest zalogowany na serwerze %@. Link nie został użyty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este celular já está conectado a %@. O link não foi usado."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O loʻo saini i totonu lenei telefoni i %@. E leʻi faʻaaogāina le soʻotaga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Taleefankan wuxuu ku xiran yahay %@. Linkiga lama isticmaalin."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Simu hii imeingia kwenye %@. Kiungo hakikutumika."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Điện thoại này đang đăng nhập vào %@. Đã bỏ qua đường liên kết."
          }
        }
      }
    },
    "This run has no route or stops to follow. Pick another run." : {
      "comment" : "Refusal when the run's geometry has no shape or no stops to judge adherence against.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für diesen Kurs gibt es keine Strecke und keine Haltestellen. Wählen Sie einen anderen Kurs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta salida no tiene ruta ni paradas que seguir. Elige otra salida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tällä vuorolla ei ole seurattavaa reittiä eikä pysäkkejä. Valitse toinen vuoro."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Walang route o hintuang susundan ang biyaheng ito. Pumili ng ibang biyahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette course n’a ni itinéraire ni arrêts à suivre. Choisissez une autre course."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस फेरे में चलने के लिए कोई रूट या स्टॉप नहीं है। कोई दूसरा फेरा चुनें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kous sa a pa gen wout ni arè pou swiv. Chwazi yon lòt kous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questa corsa non ha un percorso o fermate da seguire. Scegli un'altra corsa."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Marsaan kun daandii yookaan buufata hordofamu hin qabu. Marsaa biraa filadhu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ten kurs nie ma trasy ani przystanków. Wybierz inny kurs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta partida não tem trajeto nem paradas para seguir. Escolha outra partida."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leai se auala poʻo ni taofiga e mulimuli ai lenei taʻamilosaga. Filifili se isi taʻamilosaga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wareeggan ma laha khad ama joogsiyo la raaco. Dooro wareeg kale."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Raundi hii haina njia wala vituo vya kufuata. Chagua raundi nyingine."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chuyến này không có tuyến hay điểm dừng để đi theo. Hãy chọn chuyến khác."
          }
        }
      }
    },
    "Three riders at a stop can see your vehicle coming." : {
      "comment" : "VoiceOver: the picture on the welcome's first screen, a vehicle on its route, riders waving at the next stop and a rider's phone showing the vehicle.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Drei Fahrgäste an einer Haltestelle sehen Ihr Fahrzeug kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tres pasajeros en una parada pueden ver que tu vehículo se acerca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kolme matkustajaa pysäkillä näkee ajoneuvosi tulevan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nakikita ng tatlong pasahero sa hintuan na paparating ang sasakyan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trois passagers à un arrêt voient votre véhicule arriver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "स्टॉप पर खड़े तीन यात्री आपकी गाड़ी को आते हुए देख सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Twa pasaje nan yon arè ka wè machin ou k ap vini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tre passeggeri a una fermata vedono arrivare il tuo veicolo."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imaltoonni sadii buufata irra jiran akka konkolaataan kee dhufaa jiru arguu danda'u."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trzech pasażerów na przystanku widzi, jak nadjeżdża twój pojazd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Três passageiros em uma parada veem seu veículo chegando."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E iloa atu e pasese e toʻatolu i se taofiga lau taʻavale o loʻo sau."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saddex raakib oo joogsi ku sugaya ayaa arki kara gaarigaaga oo soo socda."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abiria watatu kwenye kituo wanaweza kuona gari lako likija."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ba hành khách ở điểm dừng thấy xe của bạn đang đến."
          }
        }
      }
    },
    "To %@" : {
      "comment" : "A segment of the direction switch over the run board; the argument is the headsign most of that direction's runs show, e.g. 'To Downtown Seattle'.",
      "localizations" : {
