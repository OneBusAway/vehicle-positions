    },
    "This phone is signed in to %@. The link was not used." : {
      "comment" : "Title of the setup link alert when the phone is already signed in, so it keeps its server: the host of that server, e.g. 'This phone is signed in to tracker.example.org. The link was not used.'"
    },
    "This run has no route or stops to follow. Pick another run." : {
      "comment" : "Refusal when the run's geometry has no shape or no stops to judge adherence against."
    },
    "Three riders at a stop can see your vehicle coming." : {
      "comment" : "VoiceOver: the picture on the welcome's first screen, a vehicle on its route, riders waving at the next stop and a rider's phone showing the vehicle."
    },
    "To %@" : {
      "comment" : "A segment of the direction switch over the run board; the argument is the headsign most of that direction's runs show, e.g. 'To Downtown Seattle'."
    },
    "Too many tries. Wait a minute, then try again." : {
      "comment" : "Banner above the sign-in button when the server refused for too many attempts; its window is one minute."
    },
    "Trip" : {
      "comment" : "CarPlay: the title of the trip's Details screen, and its row with the headsign and the run's start time, e.g. 'Downtown Seattle · 6:58 AM'."
    },
    "Trip not ended yet" : {
      "comment" : "Title of the alert shown when the server did not confirm the end of the trip."
    },
    "Try again" : {
      "comment" : "Button in the 'Trip not ended yet' alert, and on the Resume screen after a failed end: send the end again.\nButton that retries a load or a start that failed.\nChecklist row button: ask iOS for precise location again, or check Location Services again."
    },
    "Turn on automatic time in Settings." : {
      "comment" : "Help, under 'Phone clock is wrong'."
    },
    "Under the card" : {
      "comment" : "Help: the heading over the lines that can show under the status card on Tracking, and the card that takes its place when signed out."
    },
    "Use %@?" : {
      "comment" : "Title of the alert a setup link from the agency opens, which fills in the server on the sign-in screen once the driver agrees. The server's host, e.g. 'Use tracker.example.org?'."
    },
    "Use https://. Plain http:// is allowed only for localhost, 127.0.0.1 or a .local host." : {
      "comment" : "Under the server field when the address is plain http to a host the app won't send a password to."
    },
    "Use iPhone to see more" : {
      "comment" : "CarPlay: the last row of a list the car cut short; the rest of the list is on the phone."
    },
    "Use this server" : {
      "comment" : "Setup link alert: the button that fills in the link's server on the sign-in screen."
    },
    "Use your driver account for this agency." : {
      "comment" : "Under the sign-in screen's title."
    },
    "Vehicle %@" : {
      "comment" : "Resume card: the vehicle's fleet number, e.g. 'Vehicle 4317'.\nSubtitle of the route screen: the fleet number of the vehicle the driver chose, e.g. 'Vehicle 4317'.\nVoiceOver: the vehicle's row of the stop list before the first fix, and the vehicle on the map: its label or fleet number, e.g. 'Vehicle 4317'."
    },
    "Vehicle %@ · Route %@" : {
      "comment" : "Subtitle of the run screen: the fleet number of the vehicle, then the route's number, e.g. 'Vehicle 4317 · Route 7'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vehicle %1$@ · Route %2$@"
          }
        }
      }
    },
    "Vehicle %@ is out of service. Pick another vehicle." : {
      "comment" : "Banner when the server refused a start because the vehicle was taken out of service: the fleet number, e.g. 'Vehicle 4317 is out of service. Pick another vehicle.'"
    },
    "Vehicle %@, %@" : {
      "comment" : "VoiceOver: the vehicle's row of the stop list: its label or fleet number, then the status card's answer, e.g. 'Vehicle 4317, 3 min late'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vehicle %1$@, %2$@"
          }
        }
      }
    },
    "Vehicle number" : {
      "comment" : "Placeholder of the vehicle screen's search field: the fleet number painted on the vehicle."
    },
    "Vehicle, route, run" : {
      "comment" : "Welcome, screen 2: title. The three things a driver chooses before a trip."
    },
    "Version" : {
      "comment" : "Help, About: the label beside the app's version, e.g. '1.0.0 (1)'."
    },
    "Version %@ (%@)" : {
      "comment" : "Account menu: the app's version, then its build number in brackets, e.g. 'Version 1.0.0 (7)'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "Waiting for GPS" : {
      "comment" : "Status card answer before the trip's first position fix."
    },
    "Waiting for GPS. From %@, %@ run, vehicle %@" : {
      "comment" : "VoiceOver: the status card in one sentence before the first fix. The trip's first stop, the run's start time in the agency's zone, then the vehicle's label or fleet number, e.g. 'Waiting for GPS. From Northgate Station, 6:58 AM run, vehicle 4317'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Waiting for GPS. From %1$@, %2$@ run, vehicle %3$@"
          }
        }
      }
    },
    "When you finish" : {
      "comment" : "Welcome, screen 2: beside a picture of the End trip button."
    },
    "When you finish, %@." : {
      "comment" : "VoiceOver: the welcome's last row on screen 2, 'When you finish', then the name of the End trip button it pictures, filled in from that button, e.g. 'When you finish, End trip.'"
    },
    "With CarPlay. Reports start when you open the app." : {
      "comment" : "Help, under 'Open the app on iPhone': the line shows when a trip started from the car cannot report until the app is opened on the phone."
    },
    "Wrong email or password. Try again." : {
      "comment" : "Under the password field when the server turned the email and password down."
    },
    "You already have a trip running. End it before starting another." : {
      "comment" : "Banner when the server refused a start because the driver already has a trip running."
    },
    "You are on the timetable." : {
      "comment" : "Help, under 'On time'."
    },
    "You're not assigned to vehicle %@." : {
      "comment" : "Banner when the server refused a start because the driver is not assigned to the vehicle: the fleet number, e.g. 'You're not assigned to vehicle 4317.'"
    },
    "Your agency sets the server on this phone." : {
      "comment" : "Title of the setup link alert when the agency's device management sets the server, so the link was not used."
    },
    "Your agency's server setting is not a valid address, so type it here." : {
      "comment" : "Under the server field when the agency's device management set a server the app can't use."
    },
    "Your previous trip could not be ended yet. Check your connection and try again." : {
      "comment" : "Refusal when the end of a trip ended on this phone only could not be sent before the next start."
    },
    "Your trip is still open" : {
      "comment" : "Title of the card at the top of the sign-in-again sheet."
    }
  },
  "version" : "1.0"
}
