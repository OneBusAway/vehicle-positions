    "Too many tries. Wait a minute, then try again." : {
      "comment" : "Banner above the sign-in button when the server refused for too many attempts; its window is one minute.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zu viele Versuche. Warten Sie eine Minute und versuchen Sie es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Demasiados intentos. Espera un minuto e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liian monta yritystä. Odota minuutti ja yritä sitten uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masyadong maraming pagsubok. Maghintay nang isang minuto, saka subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trop de tentatives. Attendez une minute, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "बहुत बार कोशिश हो गई। एक मिनट रुकें, फिर से कोशिश करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Twòp esè. Tann yon minit, epi eseye ankò."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Troppi tentativi. Aspetta un minuto, poi riprova."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yaaliin baay'ee ta'eera. Daqiiqaa tokko eegii irra deebi'ii yaali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Za dużo prób. Odczekaj minutę i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muitas tentativas. Aguarde um minuto e tente novamente."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ʻUa tele naʻuā taumafaiga. Faʻatali se minute, ona toe taumafai lea."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Isku dayo aad u badan. Sug hal daqiiqo, kadib isku day mar kale."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Umejaribu mara nyingi mno. Subiri dakika moja, kisha ujaribu tena."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Thử quá nhiều lần. Đợi một phút rồi thử lại."
          }
        }
      }
    },
    "Trip" : {
      "comment" : "CarPlay: the title of the trip's Details screen, and its row with the headsign and the run's start time, e.g. 'Downtown Seattle · 6:58 AM'.",
