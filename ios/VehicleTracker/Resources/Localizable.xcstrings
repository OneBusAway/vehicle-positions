        },
        "ti" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "እዚ ጉዕዞ እናተኻየደ ከሎ ኣፕ ተዓጽዩ። ክሳዕ እትመርጹ ጸብጻባት ተቋሪጾም ይጸንሑ።"
