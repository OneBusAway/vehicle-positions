    "Sends the app version, the iPhone model, the server, what the app is allowed to do and recent errors. No positions, no sign-in details, no email." : {
      "comment" : "Help: under 'Share diagnostics', what the file holds and what it never holds.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sendet die App-Version, das iPhone-Modell, den Server, die Berechtigungen der App und die letzten Fehler. Keine Positionen, keine Anmeldedaten, keine E-Mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Envía la versión de la app, el modelo del iPhone, el servidor, lo que la app tiene permitido hacer y los errores recientes. Sin ubicaciones, sin datos de inicio de sesión, sin correo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lähettää sovelluksen version, iPhonen mallin, palvelimen, sovelluksen luvat ja viimeaikaiset virheet. Ei sijainteja, ei kirjautumistietoja, ei sähköpostia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ipinapadala ang bersyon ng app, ang modelo ng iPhone, ang server, kung ano ang pinapayagang gawin ng app at ang mga error kamakailan. Walang posisyon, walang detalye ng sign-in, walang email."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Envoie la version de l’application, le modèle de l’iPhone, le serveur, ce que l’application est autorisée à faire et les erreurs récentes. Aucune position, aucune donnée de connexion, aucun e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऐप का वर्शन, iPhone का मॉडल, सर्वर, ऐप को किन चीज़ों की अनुमति है और हाल की दिक्कतें भेजता है। कोई लोकेशन नहीं, साइन इन की कोई जानकारी नहीं, कोई ईमेल नहीं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Li voye vèsyon aplikasyon an, modèl iPhone nan, sèvè a, sa aplikasyon an gen dwa fè ak dènye erè li te genyen. Pa gen pozisyon, pa gen enfòmasyon pou konekte, pa gen imèl."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Invia la versione dell'app, il modello di iPhone, il server, i permessi dell'app e gli errori recenti. Nessuna posizione, nessun dato di accesso, nessuna email."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Veershinii appii, moodeela iPhone, sarvarii, wanta appiin akka godhu hayyamameef fi dogoggorawwan dhiyoo kana erga. Bakki, odeeffannoon seensaa fi imeeliin hin ergaman."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wysyła wersję aplikacji, model iPhone'a, serwer, uprawnienia aplikacji i ostatnie błędy. Bez pozycji, danych logowania i adresu e-mail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Envia a versão do app, o modelo do iPhone, o servidor, o que o app tem permissão para fazer e os erros recentes. Sem posições, sem dados de login, sem e-mail."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E lafo ai le lomiga o le app, le ituaiga iPhone, le server, mea ʻua faʻatagaina le app e fai, ma mea sese talu ai nei. E leai ni nofoaga, e leai ni faʻamatalaga o le saini, e leai se imeli."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Waxaa la diraa nooca app-ka, moodelka iPhone-ka, server-ka, waxa app-ka loo oggol yahay iyo khaladaadkii u dambeeyay. Lama diro goobo, xogta soo galka ama iimayl."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hutuma toleo la programu, muundo wa iPhone, seva, kile ambacho programu inaruhusiwa kufanya na hitilafu za hivi karibuni. Haitumi mahali, maelezo ya kuingia wala barua pepe."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gửi phiên bản ứng dụng, mẫu iPhone, máy chủ, những gì ứng dụng được phép làm và các lỗi gần đây. Không có vị trí, không có thông tin đăng nhập, không có email."
          }
        }
      }
    },
