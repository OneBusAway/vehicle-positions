        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zostaw włączoną opcję „Dokładne”, aby pasażerowie widzieli cię na właściwej ulicy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantenha “Precisa” ativada para os passageiros verem você na rua certa"
