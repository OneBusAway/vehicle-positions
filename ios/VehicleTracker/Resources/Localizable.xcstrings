          "stringUnit" : {
            "state" : "translated",
            "value" : "±%lld मी"
          }
        }
      }
    },
    "3 short screens" : {
      "comment" : "Help: under 'See the welcome again'.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 छोटी स्क्रीन"
          }
        }
      }
    },
    "A problem on the server. Tell your dispatcher." : {
      "comment" : "Help, under 'Server error'.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर में दिक्कत है। कंट्रोल रूम को बताएँ।"
          }
        }
      }
    },
    "A trip is already starting or running." : {
      "comment" : "Error when a start is attempted while a trip is already starting or running.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ट्रिप पहले से शुरू हो रही है या चल रही है।"
          }
        }
      }
    },
    "About" : {
      "comment" : "Help: the heading over the app's version and the server.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के बारे में"
          }
        }
      }
    },
    "Account" : {
      "comment" : "VoiceOver label of the account menu's button on each picker screen. The menu shows the driver's email, the server and the app's version.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अकाउंट"
          }
        }
      }
    },
    "Add %@ to favorites" : {
      "comment" : "VoiceOver label of the star on a vehicle tile that is not yet a favourite: the fleet number, e.g. 'Add 4317 to favorites'.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को पसंदीदा में जोड़ें"
          }
        }
      }
    },
    "Ahead of the timetable. Riders may miss you." : {
      "comment" : "Help, under a status like '3 min early'.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइम टेबल से आगे। यात्रियों की गाड़ी छूट सकती है।"
          }
        }
      }
    },
    "All routes" : {
      "comment" : "Section header over every route in the schedule, as rows with names.",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी रूट"
          }
        }
      }
    },
    "All routes · %lld" : {
      "comment" : "Section header over a grid of route numbers, from a feed that names none of its routes: how many there are, e.g. 'All routes · 24'.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "All routes · %lld"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "All routes · %lld"
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
