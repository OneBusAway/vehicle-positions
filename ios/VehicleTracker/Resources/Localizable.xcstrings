            "value" : "Bạn không được giao xe %@."
          }
        }
      }
    },
    "Your agency sets the server on this phone." : {
      "comment" : "Title of the setup link alert when the agency's device management sets the server, so the link was not used.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ihr Verkehrsbetrieb legt den Server auf diesem Handy fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu empresa configura el servidor en este teléfono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liikennöitsijäsi asettaa tämän puhelimen palvelimen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ang kumpanya mo ang nagtatakda ng server sa phone na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre compagnie définit le serveur de ce téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस फ़ोन पर सर्वर आपकी एजेंसी सेट करती है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se konpayi ou ki mete sèvè a sou telefòn sa a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su questo telefono il server lo imposta la tua azienda."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sarvarii bilbila kanaa dhaabbatni kee qindeessa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serwer na tym telefonie ustawia twój przewoźnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sua empresa define o servidor neste celular."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E faʻatulaga e lau kamupani le server i lenei telefoni."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Shirkaddaada ayaa dejisa server-ka taleefankan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Shirika lako ndilo huweka seva kwenye simu hii."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đơn vị vận hành của bạn thiết lập máy chủ trên điện thoại này."
          }
        }
      }
    },
    "Your agency's server setting is not a valid address, so type it here." : {
      "comment" : "Under the server field when the agency's device management set a server the app can't use.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Servereinstellung Ihres Verkehrsbetriebs ist keine gültige Adresse. Geben Sie die Adresse deshalb hier ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La configuración del servidor de tu empresa no es una dirección válida, así que escríbela aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liikennöitsijäsi palvelinasetus ei ole kelvollinen osoite, joten kirjoita osoite tähän."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi valid na address ang server setting ng kumpanya mo, kaya i-type ito rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’adresse de serveur définie par votre compagnie n’est pas valide. Entrez-la ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी एजेंसी की सर्वर सेटिंग में सही पता नहीं है, इसलिए उसे यहाँ टाइप करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Paramèt sèvè konpayi ou a pa yon adrès ki valab, kidonk ekri l isit la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L'impostazione del server della tua azienda non è un indirizzo valido, quindi scrivilo qui."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Qindaa'inni sarvarii dhaabbata keetii teessoo sirrii miti, kanaaf asitti barreessi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ustawienie serwera od przewoźnika nie jest poprawnym adresem, więc wpisz go tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A configuração de servidor da sua empresa não é um endereço válido, então digite o endereço aqui."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E lē saʻo le tuatusi server na faʻatulaga e lau kamupani, ʻo lea tusi iinei."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dejinta server-ka ee shirkaddaada maaha cinwaan sax ah, markaa halkan ku qor."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mipangilio ya seva ya shirika lako si anwani sahihi, kwa hivyo iandike hapa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cài đặt máy chủ của đơn vị vận hành không phải là địa chỉ hợp lệ, vì vậy hãy nhập địa chỉ ở đây."
          }
        }
      }
    },
    "Your previous trip could not be ended yet. Check your connection and try again." : {
      "comment" : "Refusal when the end of a trip ended on this phone only could not be sent before the next start.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ihre vorherige Fahrt konnte noch nicht beendet werden. Prüfen Sie Ihre Verbindung und versuchen Sie es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todavía no se pudo finalizar tu viaje anterior. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Edellistä matkaasi ei vielä saatu lopetettua. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi pa naitatapos ang dati mong trip. I-check ang koneksyon mo at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre trajet précédent n’a pas encore pu être terminé. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपकी पिछली ट्रिप अभी खत्म नहीं हो सकी। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dènye vwayaj ou a poko ka fini. Tcheke entènèt ou epi eseye ankò."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il tuo viaggio precedente non è ancora stato terminato. Controlla la connessione e riprova."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Imalli kee kan duraa ammallee xumuramuu hin dandeenye. Interneetii kee ilaalii irra deebi'ii yaali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poprzedniego przejazdu nie udało się jeszcze zakończyć. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ainda não foi possível encerrar sua viagem anterior. Verifique sua conexão e tente novamente."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E leʻi mafai ona faʻaiʻu lau malaga talu ai. Siaki lau fesoʻotaʻiga ona toe taumafai lea."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Safarkaagii hore weli lama dhammayn karin. Hubi internetkaaga oo isku day mar kale."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Safari yako iliyopita bado haijaweza kumalizwa. Angalia mtandao wako kisha ujaribu tena."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chưa kết thúc được hành trình trước của bạn. Hãy kiểm tra kết nối mạng rồi thử lại."
          }
        }
      }
    },
    "Your trip is still open" : {
