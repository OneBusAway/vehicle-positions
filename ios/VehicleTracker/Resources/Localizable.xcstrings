        }
      }
    },
    "Reports stop, and route %@'s %@ run is marked complete. %lld reports were sent." : {
      "comment" : "Message of the 'End this trip?' alert: the route's short name, the run's start time in the agency's zone, then how many reports reached the server, e.g. 'Reports stop, and route 7's 6:58 AM run is marked complete. 142 reports were sent.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports stop, and route %1$@'s %2$@ run is marked complete. %3$#@reports@"
          },
          "substitutions" : {
            "reports" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
