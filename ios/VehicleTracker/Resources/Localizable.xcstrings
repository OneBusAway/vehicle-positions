        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "E lē o talia e le server lipoti a lenei taʻavale. Fesili i le ofisa."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Server-ku ma aqbalayo warbixinnada gaarigan. Weydii kormeerahaaga."
          }
        },
        "sw" : {
          "stringUnit" : {
