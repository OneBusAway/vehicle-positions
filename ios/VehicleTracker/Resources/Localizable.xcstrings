    "Reports stopped when your session ended. Sign in to keep reporting on route %@." : {
      "comment" : "On the sign-in-again sheet's card. The open trip's route, e.g. '7'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seit Ihre Sitzung abgelaufen ist, werden keine Meldungen mehr gesendet. Melden Sie sich an, um auf Linie %@ weiter zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los reportes se detuvieron cuando terminó tu sesión. Inicia sesión para seguir reportando en la ruta %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Raportointi loppui, kun istuntosi päättyi. Kirjaudu sisään, niin raportointi jatkuu linjalla %@."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Huminto ang mga report nang matapos ang session mo. Mag-sign in para ituloy ang pag-report sa route %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’envoi s’est arrêté à la fin de votre session. Connectez-vous pour continuer l’envoi sur la ligne %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपका सेशन खत्म होने पर रिपोर्ट रुक गईं। रूट %@ पर रिपोर्ट भेजते रहने के लिए साइन इन करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rapò yo te kanpe lè sesyon ou an te fini. Konekte pou kontinye voye rapò sou wout %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le segnalazioni si sono interrotte alla fine della sessione. Accedi per continuare l'invio sulla linea %@."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Yeroo seensi kee xumurame gabaasni dhaabbate. Daandii %@ irratti gabaasuu itti fufuuf seeni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Raporty zatrzymały się, gdy sesja wygasła. Zaloguj się, aby dalej wysyłać raporty na linii %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O envio de posições parou quando sua sessão terminou. Entre para continuar enviando na linha %@."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na taofi lipoti ina ʻua muta lau saini. Saini i totonu e faʻaauau ai ona lafo lipoti i le auala %@."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Warbixinnadu way joogsadeen markii akoonka laga baxay. Soo gal si aad warbixinta khadka %@ u sii wadato."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ripoti zilisimama kipindi chako kilipoisha. Ingia ili uendelee kuripoti kwenye njia %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã ngừng gửi vị trí khi phiên đăng nhập của bạn kết thúc. Đăng nhập để tiếp tục gửi vị trí trên tuyến %@."
