<?xml version="1.0" encoding="utf-8"?>
<!--
    German, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    The driver is addressed as "Sie"; buttons and short card lines are infinitives ("Fahrt starten").
    "Vehicle" is Fahrzeug, never a word for one kind of vehicle; "route" is Linie; "run" is Kurs (a timetabled journey, as Austrian and Swiss
    operators use it, since "trip" takes Fahrt); "trip" is Fahrt; "block" is Umlauf; "stop" is Haltestelle, with the
    announcement's "Nächster Halt" for the next stop; "report" is Meldung, and "reporting" is senden;
    "dispatcher" is Leitstelle; "agency" is Verkehrsbetrieb; "riders" are Fahrgäste; "phone" is Handy;
    "late"/"early" are verspätet/zu früh; "sign in"/"sign out" are anmelden/abmelden.
-->
