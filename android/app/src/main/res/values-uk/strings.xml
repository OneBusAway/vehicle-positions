<?xml version="1.0" encoding="utf-8"?>
<!--
    Ukrainian, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    "Vehicle" is транспортний засіб everywhere, never the Ukrainian word for bus; "run" is рейс; "trip" is поїздка;
    "report" is звіт; "dispatcher" is диспетчер; "block" is випуск; "agency" is перевізник; "stop" is зупинка;
    "timetable" and "schedule" are both розклад; "app" is застосунок (Android's own screens say додаток);
    "location" is місцезнаходження and "all the time" is завжди, as Android's permission screens say;
    "diagnostics" is діагностика. The driver is addressed as "ви", lower case. Apostrophes are written ’.
    A run's start time follows "о" ("Рейс о 6:43"); headsigns and stop names follow a colon, since they can't be declined.
-->
