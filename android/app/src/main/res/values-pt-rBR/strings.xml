<?xml version="1.0" encoding="utf-8"?>
<!--
    Brazilian Portuguese, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    The driver is "você". "Vehicle" is veículo, never the word for bus; "route" is linha (but "off route" is fora da rota);
    "run" is partida (a timetabled departure, "a partida das 6:43"); "trip" is viagem; "stop" is parada;
    "block" is tabela, the operations word for one vehicle's day of runs; "agency" is empresa;
    "dispatcher" is a central; "report" is posição (feminine; "142 posições enviadas"), and "reporting" is o envio;
    "sign in" / "sign out" are Entrar / Sair; "schedule" (the agency's data) is programação, "timetable" is horário;
    "location" and "precise location" follow Android's own words, localização and local exato.
-->
