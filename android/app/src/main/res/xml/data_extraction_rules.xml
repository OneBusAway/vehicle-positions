<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer rules for Android 12 and above. Kept in step with backup_rules.xml, which
  covers Android 11 and below.

  device-transfer needs the same exclusion as cloud-backup and is not covered by it:
  device-to-device transfer happens whether or not cloud backup is enabled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
