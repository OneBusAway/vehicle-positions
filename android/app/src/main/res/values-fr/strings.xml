<?xml version="1.0" encoding="utf-8"?>
<!--
    French, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    International French for France and francophone Africa, "vous" throughout. "Vehicle" is always
    véhicule; "route" is ligne; "run" is course (a timetabled departure); "trip" is trajet; "report" is
    position (feminine: "142 positions envoyées"), and reporting is l’envoi; "dispatcher" is régulateur; "block" is
    bloc; "agency" is compagnie; "driver" is chauffeur; "riders" are passagers; "status card" is encadré d’état, since
    carte is the map. "Off route" is hors itinéraire, since hors ligne means offline. Location and precise location
    are Position and Position exacte, and "all the time" is Toujours autoriser, as Android says them.
    Plurals: "one" is 0 and 1; "many" is exact millions, written with "de" ("1 000 000 de positions") where a noun
    follows the count. A no-break space (U+00A0) goes before ? ! : ; and between a number and its unit.
-->
