<?xml version="1.0" encoding="utf-8"?>
<!--
    Filipino, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    Everyday Filipino with the English words drivers use on phones (sign in, server, app, link, trip, route, report).
    "You" is mo/ka/iyo, without "po", as Android's own Filipino does.
    "Vehicle" is sasakyan everywhere; "run" is biyahe (a timetabled departure, kept apart from "trip", which stays trip);
    "report" is report ("mga report", no -s); "dispatcher" is dispatcher; "block" is block; "stop" is hintuan;
    "agency" is kumpanya; "rider" is pasahero; "timetable" and "schedule" are both schedule; "check" is i-check;
    "diagnostics" is detalye ng app.
-->
