<?xml version="1.0" encoding="utf-8"?>
<!--
    Spanish, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    Neutral Latin American Spanish that addresses the driver as "tú". "Vehicle" is vehículo, the general word, everywhere;
    "run" is salida; "trip" is viaje; "report" is reporte; "dispatcher" is despachador; "block" is bloque;
    "agency" is empresa; "driver" is conductor; "rider" is pasajero; "sign in" is iniciar sesión; "settings" is
    configuración; "diagnostics" is diagnóstico. Buttons use the infinitive (Reintentar, Cancelar), sentences the
    imperative (Inténtalo de nuevo). Times arrive in placeholders with no article before them, since "las" would be
    wrong for 1:00 to 1:59.
-->
