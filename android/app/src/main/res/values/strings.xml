<resources>
    <string name="app_name">Vehicle Tracker</string>

    <!-- Sign-in screen -->
    <string name="login_title">Sign in</string>
    <string name="login_subtitle">Use your driver account for this agency.</string>
    <string name="login_server_url_label">Server address</string>
    <string name="login_email_label">Email</string>
    <string name="login_password_label">Password</string>
    <string name="login_show_password">Show password</string>
    <string name="login_hide_password">Hide password</string>
    <!-- Once the phone has signed in before: the server it used, which the driver rarely needs to change. -->
    <string name="login_server">Server</string>
    <string name="login_change_server">Change</string>
    <string name="login_button">Sign in</string>
    <string name="login_signing_in">Signing in</string>
    <!-- Under the first field left empty. -->
    <string name="login_error_missing_server">Enter the server address</string>
    <string name="login_error_missing_email">Enter your email</string>
    <string name="login_error_missing_password">Enter your password</string>
    <string name="login_error_invalid_credentials">Wrong email or password. Try again.</string>
    <!-- Under the server field when nothing answered at that address, beside the banner below. -->
    <string name="login_error_check_address">Check the address</string>
    <!-- The server's address as typed, e.g. "tracker.example.org". -->
    <string name="login_error_unreachable">Can\'t reach %1$s. Check your connection, or the server address.</string>
    <!-- The server answered, but not with a sign-in, such as a server error. -->
    <string name="login_error_server">Couldn\'t sign in. Try again.</string>
    <!-- Signing in again after the session ended during a trip. The email the driver signed in with last. -->
    <string name="login_again_title">Sign in again</string>
    <string name="login_again_subtitle">As %1$s</string>
    <string name="login_again_button">Sign in and keep reporting</string>
    <string name="login_trip_open_title">Your trip is still open</string>
    <!-- The open trip's route, e.g. "7". -->
    <string name="login_trip_open_message">Reports stopped when your session ended. Sign in to keep reporting on route %1$s.</string>

    <!-- The top of the route and run steps: Back, then the trip so far as chips, each going back to its step. -->
    <string name="setup_navigate_up">Navigate up</string>
    <string name="setup_trip_so_far">Trip so far</string>
    <!-- Read before the bus's number on its chip, e.g. "Bus, 4317". -->
    <string name="setup_bus">Bus</string>
    <!-- The route's chip, read out, e.g. "Route 7". -->
    <string name="setup_route">Route %1$s</string>
    <!-- After the chips: the step the driver is on. -->
    <string name="setup_step_route">Route</string>
    <string name="setup_step_run">Run</string>

    <!-- In a setup screen's search field, once something is typed. -->
    <string name="setup_clear_search">Clear search</string>

    <!-- Vehicle selection screen -->
    <string name="vehicles_title">Choose your bus</string>
    <string name="vehicles_empty">No buses are assigned to you</string>
    <string name="vehicles_empty_detail">Ask your dispatcher to assign one, then check again.</string>
    <string name="vehicles_check_again">Check again</string>
    <string name="vehicles_error_message">Couldn\'t load your buses</string>
    <string name="vehicles_error_detail">Check your connection and try again.</string>
    <string name="vehicles_retry_button">Try again</string>
    <string name="vehicles_search_label">Bus number</string>
    <!-- What the driver typed, e.g. "No bus matches 999". -->
    <string name="vehicles_search_no_matches">No bus matches %1$s</string>
    <string name="vehicles_search_no_matches_detail">Check the fleet number on the bus.</string>
    <string name="vehicles_section_favorites">Favorites</string>
    <string name="vehicles_section_recent">Recent</string>
    <string name="vehicles_section_all">All buses</string>
    <string name="vehicles_section_matches">Matches</string>
    <!-- How TalkBack describes a starred bus's tile, e.g. "4317, Bus 4317, Favorite". -->
    <string name="vehicles_tile_favorite">Favorite</string>
    <string name="vehicles_favorite_description">Add %1$s to favorites</string>
    <string name="vehicles_unfavorite_description">Remove %1$s from favorites</string>

    <!-- Route picker -->
    <string name="routes_title">Choose a route</string>
    <string name="routes_search_label">Route number or name</string>
    <string name="routes_section_recent">Recent</string>
    <string name="routes_section_all">All routes</string>
    <!-- Over a grid of route numbers, from a feed that names none of its routes: how many there are. -->
    <plurals name="routes_section_all_count">
        <item quantity="one">All routes · %1$d</item>
        <item quantity="other">All routes · %1$d</item>
    </plurals>
    <string name="routes_section_matches">Matches</string>
    <!-- What the driver typed, e.g. "No route matches 999". -->
    <string name="routes_search_no_matches">No route matches %1$s</string>
    <string name="routes_search_no_matches_detail">Search by the number on the sign, or part of the name.</string>
    <string name="routes_empty">The schedule has no routes</string>
    <string name="routes_empty_detail">Ask your agency\'s admin to check the schedule.</string>
    <string name="routes_check_again">Check again</string>
    <string name="routes_error_message">Couldn\'t load the routes</string>
    <string name="routes_error_detail">Check your connection and try again.</string>
    <string name="routes_no_schedule">No schedule on this server yet</string>
    <string name="routes_no_schedule_detail">An operator has to load one before trips can start. Tell your agency\'s admin.</string>
    <string name="routes_retry_button">Try again</string>
    <!-- Stands in for a route whose feed gave no short name. -->
    <string name="routes_badge_placeholder">\u2014</string>

    <!-- Run picker -->
    <string name="runs_title">Choose a run</string>
    <!-- The route's number, e.g. "No runs on route 7 today". -->
    <string name="runs_empty">No runs on route %1$s today</string>
    <!-- The same, for a route whose feed gave no short name. -->
    <string name="runs_empty_unnamed">No runs on this route today</string>
    <string name="runs_empty_detail">Pick another route, or check again tomorrow.</string>
    <string name="runs_choose_another_route">Choose another route</string>
    <!-- On the run under way or next to start, and, for TalkBack, on the line between the runs gone and the rest. -->
    <string name="runs_badge_now">Now</string>
    <string name="runs_badge_next">Next</string>
    <!-- The direction switch: where most runs that way are headed, e.g. "To Downtown Seattle". -->
    <string name="runs_direction">To %1$s</string>
    <!-- Under the date: the first stop, then the last stop, of the direction shown. -->
    <string name="runs_row_stops">%1$s \u2192 %2$s</string>
    <!-- What TalkBack says on the run being started. -->
    <string name="runs_starting">Starting\u2026</string>
    <string name="runs_error_message">Couldn\'t load the runs</string>
    <string name="runs_error_detail">Check your connection and try again.</string>
    <string name="runs_retry_button">Try again</string>
    <!-- The bus the driver chose, e.g. "You're not assigned to bus 4317." -->
    <string name="runs_error_not_assigned">You\'re not assigned to bus %1$s.</string>
    <string name="runs_change_bus">Change bus</string>
    <string name="runs_error_trip_active">You already have a trip running. End it before starting another.</string>
    <string name="runs_error_previous_trip_not_ended">Your previous trip could not be ended yet. Check your connection and try again.</string>
    <string name="runs_error_network">Can\'t reach the server. Check your connection.</string>
    <string name="runs_error_no_geometry">This run has no route or stops to follow. Pick another run.</string>
    <string name="runs_error_trip_not_active">The schedule moved on to a new day.</string>
    <string name="runs_reload_button">Reload</string>
    <string name="runs_error_other">Couldn\'t start the trip.</string>

    <!-- Tracking screen -->
    <!-- The tracking notification's text. The screen says the same things in its own words, below. -->
    <string name="tracking_status_connected">Tracking – Connected</string>
    <string name="tracking_status_no_network">No connection</string>
    <string name="tracking_status_no_gps">GPS unavailable</string>
    <string name="tracking_status_clock_skew">Check device clock</string>
    <string name="tracking_status_auth_expired">Session expired – log in again</string>
    <string name="tracking_status_reports_refused">Reports refused – ask your dispatcher</string>
    <!-- The trip bar: the trip's running time, then how many reports have reached the server. -->
    <plurals name="tracking_bar_sent">
        <item quantity="one">%1$d sent</item>
        <item quantity="other">%1$d sent</item>
    </plurals>
    <!-- What tapping the trip bar does, for TalkBack. -->
    <string name="tracking_bar_click_label">Show trip details</string>
    <string name="tracking_end_trip_button">End trip</string>
    <string name="tracking_end_trip_ending">Ending…</string>
    <!-- The rows at the top of the panel the trip bar pulls up into. -->
    <string name="tracking_fact_run">Run</string>
    <!-- The run's start time in the agency's zone, then the vehicle, e.g. "6:58 AM · 4317". -->
    <string name="tracking_fact_run_vehicle">%1$s · %2$s</string>
    <string name="tracking_fact_reports">Reports</string>
    <string name="tracking_reports_reporting">Reporting</string>
    <string name="tracking_reports_not_reporting">Not reporting</string>
    <string name="tracking_reports_no_gps">No GPS</string>
    <string name="tracking_reports_stopped">Reports stopped</string>
    <string name="tracking_fact_street_map">Street map</string>
    <string name="tracking_street_map_ready">Ready</string>
    <string name="tracking_street_map_downloading">Downloading · %1$d%%</string>
    <string name="tracking_street_map_not_downloaded">Not downloaded yet</string>
    <string name="tracking_street_map_no_space">Not enough space</string>
    <string name="tracking_street_map_unusable">Not usable</string>
    <string name="tracking_end_trip_dialog_title">End this trip?</string>
    <!-- The route's short name, the run's start time in the agency's zone, then how many reports reached the server. -->
    <plurals name="tracking_end_trip_dialog_message">
        <item quantity="one">Reports stop, and route %1$s\'s %2$s run is marked complete. %3$d report was sent.</item>
        <item quantity="other">Reports stop, and route %1$s\'s %2$s run is marked complete. %3$d reports were sent.</item>
    </plurals>
    <!-- The same, for a trip whose route name or schedule the phone does not have. -->
    <plurals name="tracking_end_trip_dialog_message_no_run">
        <item quantity="one">Reports stop, and this run is marked complete. %1$d report was sent.</item>
        <item quantity="other">Reports stop, and this run is marked complete. %1$d reports were sent.</item>
    </plurals>
    <string name="tracking_end_trip_dialog_confirm">End trip</string>
    <string name="tracking_end_trip_dialog_cancel">Keep going</string>
    <!-- The server did not confirm the end. Also on the resume prompt, after End Shift. -->
    <string name="tracking_end_trip_error_title">Trip not ended yet</string>
    <string name="tracking_end_trip_error_message">The server didn\'t confirm the end. Check your signal and try again, or stop reporting on this phone now.</string>
    <string name="tracking_end_trip_error_retry">Try again</string>
    <string name="tracking_end_trip_error_end_locally">End on this phone</string>
    <string name="tracking_reauth_button">Sign in</string>
    <!-- Between two parts of one line, e.g. "No connection · Riders can't see you". -->
    <string name="tracking_separator" translatable="false">·</string>
    <!-- Under the status card while reports are not getting through: what is wrong, then what it means. -->
    <string name="tracking_problem_no_network">No connection</string>
    <string name="tracking_problem_no_network_detail">Riders can\'t see you</string>
    <string name="tracking_problem_no_gps">No GPS signal</string>
    <string name="tracking_problem_no_gps_detail">Position paused</string>
    <string name="tracking_problem_clock_skew">Phone clock is wrong</string>
    <string name="tracking_problem_clock_skew_detail">Set automatic time</string>
    <string name="tracking_problem_reports_refused">Reports refused</string>
    <string name="tracking_problem_reports_refused_detail">Ask your dispatcher</string>
    <!-- In the status card's place once the driver's sign-in has expired. -->
    <string name="tracking_signed_out_title">Signed out</string>
    <string name="tracking_signed_out_message">Reports have stopped. Your trip is still open.</string>

    <!-- Status card: how the driver is keeping to the route and the schedule -->
    <string name="tracking_adherence_on_time">On time</string>
    <plurals name="tracking_adherence_minutes_late">
        <item quantity="one">%1$d min late</item>
        <item quantity="other">%1$d min late</item>
    </plurals>
    <plurals name="tracking_adherence_minutes_early">
        <item quantity="one">%1$d min early</item>
        <item quantity="other">%1$d min early</item>
    </plurals>
    <!-- Beyond the server's schedule window. The card's answer above it says how far off, e.g. "20 min late". -->
    <string name="tracking_adherence_off_schedule">Off schedule</string>
    <string name="tracking_adherence_right_run">Is this the right run?</string>
    <!-- The next stop's name, then its scheduled time in the agency's zone. -->
    <string name="tracking_adherence_off_schedule_next">Next %1$s · %2$s</string>
    <!-- How far from the route, e.g. "Off route · 120 m". -->
    <string name="tracking_adherence_off_route">Off route · %1$s</string>
    <!-- What TalkBack announces when the vehicle leaves the route: the distance changes with every fix, so it is left out. -->
    <string name="tracking_adherence_off_route_short">Off route</string>
    <!-- Beside the next stop's name. -->
    <string name="tracking_adherence_next_stop">Next</string>
    <!-- The next stop's scheduled time in the agency's zone, then the distance to it. -->
    <string name="tracking_adherence_next_stop_detail">%1$s · %2$s</string>
    <string name="tracking_adherence_distance_m">%1$d m</string>
    <string name="tracking_adherence_distance_km">%1$.1f km</string>
    <string name="tracking_adherence_waiting_for_gps">Waiting for GPS</string>
    <!-- Beside the trip's first stop while waiting for the first fix. -->
    <string name="tracking_adherence_from">From</string>
    <!-- The run's start time in the agency's zone, then the vehicle, e.g. "6:58 AM run · 4317". -->
    <string name="tracking_adherence_run">%1$s run</string>
    <string name="tracking_adherence_run_vehicle">%1$s run · %2$s</string>
    <!-- Tracking with no copy of the trip's shape and stops to judge against. -->
    <string name="tracking_adherence_no_schedule">No schedule</string>
    <string name="tracking_adherence_no_schedule_riders">Riders still see the bus</string>
    <string name="tracking_adherence_no_schedule_detail">This run has no timetable</string>
    <!-- On the tracking screen's map, once the driver has dragged it away from the vehicle. -->
    <string name="tracking_map_recenter">Re-center</string>
    <string name="tracking_map_downloading">Downloading map, %1$d%%</string>
    <string name="tracking_map_no_space">Not enough space for the map</string>
    <string name="tracking_map_retrying">Map not downloaded yet, will retry</string>
    <!-- Something went wrong on the phone, such as the map record failing to save. The app tries again only when it next comes to the front, or a day later. -->
    <string name="tracking_map_retry_on_open">Map not downloaded, will try again when the app is next opened</string>
    <!-- The map URL gives something that is not a map. The app leaves that URL alone for a day. -->
    <string name="tracking_map_unusable">Map file is not usable, tell your agency</string>
    <!-- The map URL is plain http, which the phone refuses. The app tries again only when it next comes to the front. -->
    <string name="tracking_map_needs_https">Map link must use https, tell your agency</string>

    <!-- Resume prompt: a trip was stored but its tracking service was not running at launch -->
    <string name="resume_title">Resume Shift?</string>
    <string name="resume_message">An incomplete shift with Vehicle %1$s was detected. The app was closed while tracking was active.</string>
    <string name="resume_route">Route %1$s</string>
    <plurals name="resume_started_minutes_ago">
        <item quantity="one">Started %1$d min ago</item>
        <item quantity="other">Started %1$d min ago</item>
    </plurals>
    <!-- Hours, then minutes past the hour, e.g. "Started 2 h 5 min ago". -->
    <string name="resume_started_hours_ago">Started %1$d h %2$d min ago</string>
    <string name="resume_button">Resume</string>
    <string name="resume_end_shift_button">End Shift</string>

    <!-- Tracking notification -->
    <string name="tracking_notification_channel_name">Trip Tracking</string>
    <string name="tracking_notification_title">OBA Tracker is active</string>
    <string name="tracking_notification_resume_title">Tap to resume tracking</string>
    <string name="tracking_notification_resume_text">Location tracking paused. Open the app to resume.</string>

    <!-- Permission flow -->
    <string name="permission_location_approx_title">Approximate Location Only</string>
    <string name="permission_location_approx_message">Precise location wasn\'t granted, so tracking will be less accurate. You can grant precise location or continue with approximate location.</string>
    <string name="permission_grant_precise_button">Grant Precise Location</string>
    <string name="permission_continue_button">Continue</string>
    <string name="permission_location_denied_title">Location Access Needed</string>
    <string name="permission_location_denied_message">Location permission is required to start tracking a trip.</string>
    <string name="permission_retry_button">Try Again</string>
    <string name="permission_cancel_button">Cancel</string>
    <string name="permission_background_title">Keep Tracking in the Background</string>
    <string name="permission_background_message">To keep sending your location when the app isn\'t on screen, choose \"Allow all the time\" on the next screen.</string>
    <string name="permission_skip_button">Not Now</string>
    <string name="permission_notifications_denied_message">Notifications were not granted. You won\'t see the tracking status notification, but tracking will still run.</string>
    <string name="permission_ok_button">OK</string>
    <string name="permission_battery_title">Prevent Battery Optimization</string>
    <string name="permission_battery_message">To keep tracking reliably in the background, allow this app to ignore battery optimizations.</string>
    <string name="permission_location_services_off_title">Turn On Location Services</string>
    <string name="permission_location_services_off_message">Device location services must be turned on to start tracking.</string>
</resources>
