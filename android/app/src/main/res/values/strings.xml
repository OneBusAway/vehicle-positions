    <string name="server_setup_refused_signed_in">This phone is signed in to %1$s. The link was not used.</string>
    <!-- A trip is stored, but not which server it is on: one stored by an older build, after a restore from backup. -->
    <string name="server_setup_refused_trip_open">This phone has a trip open. The link was not used.</string>
