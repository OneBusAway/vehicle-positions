    <string name="tracking_problem_no_network_detail">Riders can\'t see you</string>
    <string name="tracking_problem_no_gps">No GPS signal</string>
    <string name="tracking_problem_no_gps_detail">Position paused</string>
    <string name="tracking_problem_clock_skew">Phone clock is wrong</string>
    <string name="tracking_problem_clock_skew_detail">Set automatic time</string>
    <string name="tracking_problem_reports_refused">Reports refused</string>
    <string name="tracking_problem_reports_refused_detail">Ask your dispatcher</string>
    <!-- The status card's last line, and the notification's, while reports saved with no connection wait on the phone. It takes the place of the next stop's time and distance, in one line on a narrow phone. The count is grouped, e.g. "1,244", as the phone keeps up to 8,640. -->
    <plurals name="tracking_waiting">
        <item quantity="one">%1$,d report to send when online</item>
        <item quantity="other">%1$,d reports to send when online</item>
    </plurals>
    <!-- The same, for reports saved under another sign-in, which nothing will send under this one. Help says why. -->
    <plurals name="tracking_waiting_never">
        <item quantity="one">%1$,d report won\'t send</item>
        <item quantity="other">%1$,d reports won\'t send</item>
    </plurals>
    <!-- In the status card's place once the driver's sign-in has expired. -->
    <string name="tracking_signed_out_title">Signed out</string>
    <string name="tracking_signed_out_message">Reports have stopped. Your trip is still open.</string>

    <!-- Status card: how the driver is keeping to the route and the schedule -->
    <string name="tracking_adherence_on_time">On time</string>
    <!-- Whole minutes behind the timetable, e.g. "3 min late". -->
    <plurals name="tracking_adherence_minutes_late">
        <item quantity="one">%1$d min late</item>
        <item quantity="other">%1$d min late</item>
    </plurals>
    <!-- Whole minutes ahead of the timetable, e.g. "2 min early". -->
    <plurals name="tracking_adherence_minutes_early">
        <item quantity="one">%1$d min early</item>
        <item quantity="other">%1$d min early</item>
    </plurals>
    <!-- Beyond the server's schedule window. The card's answer above it says how far off, e.g. "20 min late". -->
    <string name="tracking_adherence_off_schedule">Off schedule</string>
    <string name="tracking_adherence_right_run">Is this the right run?</string>
    <!-- The next stop's name, then its scheduled time in the agency's zone. -->
    <string name="tracking_adherence_off_schedule_next">Next %1$s · %2$s</string>
    <!-- How far from the route, e.g. "Off route · 120 m". -->
    <string name="tracking_adherence_off_route">Off route · %1$s</string>
    <!-- What TalkBack announces when the vehicle leaves the route: the distance changes with every fix, so it is left out. -->
    <string name="tracking_adherence_off_route_short">Off route</string>
    <!-- Beside the next stop's name. -->
    <string name="tracking_adherence_next_stop">Next</string>
    <!-- The next stop's scheduled time in the agency's zone, then the distance to it. -->
    <string name="tracking_adherence_next_stop_detail">%1$s · %2$s</string>
    <!-- The distance to the next stop in metres, under a kilometre, e.g. "350 m". -->
    <string name="tracking_adherence_distance_m">%1$d m</string>
    <!-- The same in kilometres, to one decimal place, e.g. "1.2 km". -->
    <string name="tracking_adherence_distance_km">%1$.1f km</string>
    <string name="tracking_adherence_waiting_for_gps">Waiting for GPS</string>
    <!-- Beside the trip's first stop while waiting for the first fix. -->
    <string name="tracking_adherence_from">From</string>
    <!-- The run's start time in the agency's zone, then the vehicle, e.g. "6:58 AM run · 4317". -->
    <string name="tracking_adherence_run">%1$s run</string>
    <!-- The same, then the vehicle, e.g. "6:58 AM run · 4317". -->
    <string name="tracking_adherence_run_vehicle">%1$s run · %2$s</string>
    <!-- Tracking with no copy of the trip's shape and stops to judge against. -->
    <string name="tracking_adherence_no_schedule">No schedule</string>
    <string name="tracking_adherence_no_schedule_riders">Riders still see you</string>
    <string name="tracking_adherence_no_schedule_detail">This run has no times</string>
    <!-- On the tracking screen's map, once the driver has dragged it away from the vehicle. -->
    <string name="tracking_map_recenter">Re-center</string>
    <!-- How much of the street map has downloaded, as a percentage, e.g. "Downloading map, 40%". -->
    <string name="tracking_map_downloading">Downloading map, %1$d%%</string>
    <string name="tracking_map_no_space">Not enough space for the map</string>
    <string name="tracking_map_retrying">Map not downloaded yet, will retry</string>
    <!-- Something went wrong on the phone, such as the map record failing to save. The app tries again only when it next comes to the front, or a day later. -->
    <string name="tracking_map_retry_on_open">Map not downloaded, will try again when the app is next opened</string>
    <!-- The map URL gives something that is not a map. The app leaves that URL alone for a day. -->
    <string name="tracking_map_unusable">Map file is not usable, tell your agency</string>
    <!-- The map URL is plain http, which the phone refuses. The app tries again only when it next comes to the front. -->
    <string name="tracking_map_needs_https">Map link must use https, tell your agency</string>

    <!-- Resume prompt: a trip was stored but its tracking service was not running at launch -->
    <string name="resume_title">Resume your trip?</string>
    <string name="resume_message">The app closed while this trip was running. Reports are paused until you choose.</string>
    <!-- In place of where the run goes, for a trip the phone has no schedule for. The route's id. -->
    <string name="resume_route">Route %1$s</string>
    <!-- The run's first departure in the agency's zone, e.g. "6:58 AM run". -->
    <string name="resume_run">%1$s run</string>
    <!-- The vehicle the trip is on, e.g. "Vehicle 4317". -->
    <string name="resume_bus">Vehicle %1$s</string>
    <!-- Whole minutes since the trip began, then the time it began, e.g. "Started 23 min ago, at 6:58 AM". -->
    <plurals name="resume_started_minutes_ago">
        <item quantity="one">Started %1$d min ago, at %2$s</item>
        <item quantity="other">Started %1$d min ago, at %2$s</item>
    </plurals>
    <!-- Hours, then minutes past the hour, then the time it began, e.g. "Started 2 h 5 min ago, at 6:58 AM". -->
    <string name="resume_started_hours_ago">Started %1$d h %2$d min ago, at %3$s</string>
    <string name="resume_button">Resume trip</string>
    <string name="resume_end_trip_button">End trip</string>
    <string name="resume_ending">Ending trip</string>
    <string name="resume_loading">Loading your trip</string>
    <!-- Above the buttons once the server did not confirm the end; they then say Try again and End on this phone. -->
    <string name="resume_end_failed">The server didn\'t confirm the trip ended. Try again, or end it on this phone only.</string>
    <!-- Goes back from a failed end to Resume and End trip, for a driver who tapped End trip by mistake. -->
    <string name="resume_end_failed_back">Don\'t end the trip</string>

    <!-- The tracking notification's channel: Android lists it in the app's notification settings. -->
    <string name="tracking_notification_channel_name">Trip reporting</string>
    <!-- The tracking notification's title: the route's short name, then the status card's words, e.g. "Route 7 · On time". -->
    <string name="tracking_notification_title">Route %1$s · %2$s</string>
    <!-- The next stop, its time in the agency's zone, then the Reports row's word, e.g. "Next 3rd Ave & Seneca St · 7:18 AM · Reporting". -->
    <string name="tracking_notification_next">Next %1$s · %2$s · %3$s</string>
    <string name="tracking_notification_signed_out">Signed out. Open the app to sign in.</string>
    <!-- The status card's problem line, "Reports refused" over "Ask your dispatcher", as one line. -->
    <string name="tracking_notification_reports_refused">Reports refused. Ask your dispatcher.</string>
    <string name="tracking_notification_resume_title">Reports paused</string>
    <string name="tracking_notification_resume_text">Open the app to keep reporting.</string>
    <!-- The channel of the notification above, which makes a sound: Android lists it in the app's notification settings. -->
    <string name="tracking_notification_attention_channel_name">Trip needs you</string>

    <!-- The checklist before a trip, shown when the app is missing something it needs. -->
    <string name="preflight_title">Before you start</string>
    <!-- Under the title: the vehicle's fleet number, e.g. "The app needs these to report vehicle 4317." -->
    <string name="preflight_message">The app needs these to report vehicle %1$s. Android asks about each one next.</string>
    <string name="preflight_location">Location</string>
    <string name="preflight_location_why">So the app knows where the vehicle is</string>
    <string name="preflight_precise">Precise location</string>
    <string name="preflight_precise_why">So riders see the vehicle at the right stop</string>
    <string name="preflight_background">All the time</string>
    <!-- Reports go on with the screen off without it; it lets the app restart reporting by itself. -->
    <string name="preflight_background_why">So reporting can restart if Android closes the app</string>
    <string name="preflight_notifications">Notifications</string>
    <string name="preflight_notifications_why">So you can see that reporting is on</string>
    <string name="preflight_battery">Battery</string>
    <string name="preflight_battery_why">So Android doesn\'t stop reports mid-trip</string>
    <string name="preflight_location_services">Location services</string>
    <string name="preflight_location_services_why">Location must be on for the whole phone</string>
    <!-- At the end of a row, once Android has asked about it, or before it asks next. -->
    <string name="preflight_allowed">Allowed</string>
    <string name="preflight_skipped">Skipped</string>
    <string name="preflight_next">Next</string>
    <!-- What TalkBack reads at the end of a row: the row's name, then one of the three above, e.g. "Location, Allowed". -->
    <string name="preflight_row_state">%1$s, %2$s</string>
    <!-- In place of a row's reason once the driver has said no to something the app can do without. -->
    <string name="preflight_skipped_why">Not allowed. Reports still work.</string>
    <string name="preflight_location_needed">Location is needed to report</string>
    <string name="preflight_approximate">Only approximate was allowed</string>
    <string name="preflight_try_again">Try again</string>
    <string name="preflight_open_settings">Open settings</string>
    <string name="preflight_continue">Continue</string>
</resources>
