    <string name="server_setup_invalid">This link does not contain a server address the app can use.</string>
    <string name="server_setup_ok">OK</string>

    <!-- The app's managed configuration, as an agency's device management console shows it. -->
    <string name="restriction_server_url_title">Server address</string>
    <string name="restriction_server_url_description">The agency\'s tracker server, an https:// address. Drivers sign in to it and can\'t change it.</string>

    <!-- The welcome: three short screens a driver sees once, after the first sign-in on this phone and before choosing a vehicle. -->
    <!-- Leaves the welcome from any of its screens. -->
    <string name="welcome_skip">Skip</string>
    <!-- The button on the first two screens, and on the last. -->
    <string name="welcome_next">Next</string>
    <string name="welcome_continue">Continue</string>
    <!-- What TalkBack reads for the line at the top, where a vehicle moves one stop for each screen, e.g. "Step 1 of 3". -->
    <string name="welcome_step">Step %1$d of %2$d</string>
    <!-- Screen 1: what the app does for riders. -->
    <string name="welcome_riders_title">Riders can see you coming</string>
    <string name="welcome_riders_body">Start a trip and riders see your vehicle on their map. End it when you finish.</string>
    <!-- What TalkBack reads for screen 1's picture, a vehicle coming up its route to a stop where riders watch it on a phone. -->
    <string name="welcome_riders_picture">Three riders at a stop can see your vehicle coming.</string>
    <!-- Screen 2: the three choices before a trip, each on a card with the picker's own title over a hint. -->
    <string name="welcome_pieces_title">Vehicle, route, run</string>
