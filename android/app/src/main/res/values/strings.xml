    <string name="login_server_managed">Set by your agency.</string>
    <!-- Under the server field when the agency's device management sets a server the app can't use, so it is ignored. -->
    <string name="login_server_managed_invalid">Your agency\'s server setting is not a valid address, so type it here.</string>

