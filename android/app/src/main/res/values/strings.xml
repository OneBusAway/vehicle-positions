    <string name="welcome_habits_title">Keep it reporting</string>
    <string name="welcome_habits_body">Do these 3 things on every trip.</string>
    <string name="welcome_habits_location">Allow location all the time</string>
    <string name="welcome_habits_location_why">So reporting can restart by itself</string>
    <string name="welcome_habits_charge">Keep the phone on charge</string>
    <string name="welcome_habits_charge_why">The screen stays on while it charges</string>
    <string name="welcome_habits_open">Leave the app open</string>
    <string name="welcome_habits_open_why">Don\'t swipe it away during a trip</string>
    <!-- Over a picture of the Reports paused notification. -->
    <string name="welcome_habits_if_stops">If reporting stops</string>

    <!-- A tip shown once to each driver, on the run board, pointing at the run under way. A tap on a run asks first. -->
    <string name="tip_run_board_title">Tap your run</string>
