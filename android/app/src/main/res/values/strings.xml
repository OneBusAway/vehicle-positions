    <plurals name="first_trip_done_reports">
        <item quantity="one">report sent</item>
        <item quantity="other">reports sent</item>
    </plurals>
    <string name="first_trip_done_text">Riders could see your vehicle.</string>
    <string name="first_trip_done_ok">OK</string>

