    <string name="tip_sent_count_title">Reports sent</string>
    <string name="tip_sent_count_text">This number grows while riders can see you. No signal? Keep driving. Reports are saved and sent later.</string>
    <!-- The one button on a tip, which closes it. -->
    <string name="tip_got_it">Got it</string>
