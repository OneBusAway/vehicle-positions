    <string name="welcome_pieces_body">Choose them, then tap your run to start. End the trip when you finish.</string>
    <string name="welcome_pieces_vehicle_hint">The number on the vehicle</string>
    <string name="welcome_pieces_route_hint">The number on the sign</string>
    <string name="welcome_pieces_run_hint">A tap starts the trip</string>
    <!-- On a green card like the status card, once the three are chosen. -->
    <string name="welcome_pieces_live">Riders see you</string>
    <!-- Beside a picture of the End trip button. -->
    <string name="welcome_pieces_finish">When you finish</string>
