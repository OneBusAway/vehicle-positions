<?xml version="1.0" encoding="utf-8"?>
<!--
    Arabic, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    Modern Standard Arabic as phone apps write it: the driver is addressed with the masculine imperative (اختر، انقر)
    and buttons use the verbal noun, as Arabic Android does (تسجيل الدخول، إعادة المحاولة، إلغاء، التالي).
    "Vehicle" is مركبة, never a word for bus; "route" is خط; "run" is دورة; "trip" is رحلة; "stop" is محطة;
    "block" is بلوك (a loan word, to check with drivers); "report" is تقرير, and "reporting" is الإرسال;
    "dispatcher" is غرفة العمليات; "agency" is جهة العمل; "riders" is الركاب; the timetable is الجدول.
    "min" and "h" are د and س; the literal 3s are written ٣.
-->
