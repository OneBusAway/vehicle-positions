<?xml version="1.0" encoding="utf-8"?>
<!--
    Vietnamese, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    The driver is "bạn". "Vehicle" is xe, never the word for bus; "route" is tuyến; "run" is chuyến (a timetabled departure);
    "trip" is hành trình (the driver's journey in the app, as in "giám sát hành trình"); "stop" is điểm dừng;
    "block" is chuỗi chuyến; "agency" is đơn vị vận hành; "dispatcher" is điều độ; "riders" is hành khách;
    "report" is vị trí (one position sent, counted as "142 vị trí"), so "reporting" is gửi vị trí;
    "server" is máy chủ; "late" and "early" are trễ and sớm; "off route" is lệch tuyến;
    "diagnostics" is thông tin chẩn đoán. Vietnamese has one plural form, "other".
-->
