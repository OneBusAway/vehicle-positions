<?xml version="1.0" encoding="utf-8"?>
<!--
    Russian, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    "Vehicle" is машина everywhere, the word drivers use at work for whatever they drive; "run" is рейс;
    "trip" is поездка; "report" is отметка (feminine: one position sent), and "reporting" is отправка;
    "dispatcher" is диспетчер; "block" is выход (a vehicle's day of runs, as depots say "выход 5");
    "agency" is перевозчик; "fleet number" is бортовой номер; late and early are опоздание and опережение;
    "diagnostics" is данные диагностики. The driver is addressed as "вы", lower case.
-->
