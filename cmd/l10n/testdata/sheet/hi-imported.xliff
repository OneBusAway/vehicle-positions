<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/os/xliff-core-1.2-strict.xsd">
  <file original="en.lproj/InfoPlist.strings" datatype="plaintext" source-language="en" target-language="hi">
    <header>
      <tool tool-id="com.apple.dt.xcode" tool-name="Xcode" tool-version="27.1" build-num="27A9275"/>
    </header>
    <body>
      <trans-unit id="CFBundleDisplayName" xml:space="preserve">
        <source>OBA Vehicle Tracker</source>
        <target state="translated">OBA Vehicle Tracker</target>
        <note>Bundle display name</note>
      </trans-unit>
    </body>
  </file>
  <file original="App/Localizable.xcstrings" source-language="en" target-language="hi" datatype="plaintext">
    <header>
      <tool tool-id="com.apple.dt.xcode" tool-name="Xcode" tool-version="27.1" build-num="27A9275"/>
    </header>
    <body>
      <trans-unit id="%lld reports sent|==|plural.one" xml:space="preserve">
        <source>%lld report sent</source>
        <target state="translated">%lld रिपोर्ट भेजी गई</target>
        <note>How many reports the trip sent.</note>
      </trans-unit>
      <trans-unit id="%lld reports sent|==|plural.other" xml:space="preserve">
        <source>%lld reports sent</source>
        <target state="translated">%lld रिपोर्ट भेजी गईं</target>
        <note>How many reports the trip sent.</note>
      </trans-unit>
      <trans-unit id="Can't reach %@. Check your connection." xml:space="preserve">
        <source>Can't reach %@. Check your connection.</source>
        <target state="translated">%@ तक नहीं पहुँच सके।</target>
        <note>The server's address, e.g. tracker.example.org.</note>
      </trans-unit>
      <trans-unit id="Route %@, %lld reports sent" xml:space="preserve">
        <source>Route %1$@, %2$#@reports@</source>
        <target state="translated">रूट %1$@, %2$#@reports@</target>
        <note>VoiceOver: the route's short name, then how many reports the trip sent.</note>
      </trans-unit>
      <trans-unit id="Route %@, %lld reports sent|==|substitutions.reports.plural.one" xml:space="preserve">
        <source>%2$lld report sent</source>
        <target state="translated">%2$lld रिपोर्ट भेजी गई</target>
        <note>VoiceOver: the route's short name, then how many reports the trip sent.</note>
      </trans-unit>
      <trans-unit id="Route %@, %lld reports sent|==|substitutions.reports.plural.other" xml:space="preserve">
        <source>%2$lld reports sent</source>
        <target state="translated">%2$lld रिपोर्ट भेजी गईं</target>
        <note>VoiceOver: the route's short name, then how many reports the trip sent.</note>
      </trans-unit>
      <trans-unit id="Sign in" xml:space="preserve">
        <source>Sign in</source>
        <target state="translated">साइन इन करें</target>
        <note>The sign-in screen's title.</note>
      </trans-unit>
      <trans-unit id="Started %lld min ago" xml:space="preserve">
        <source>Started %lld min ago</source>
        <target state="translated">%lld मिनट पहले शुरू</target>
        <note/>
      </trans-unit>
    </body>
  </file>
</xliff>
